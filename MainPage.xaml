<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Biblia.Presentation.Views.MainPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:Biblia.Presentation.ViewModels" x:DataType="vm:MainViewModel" Title="Início" BackgroundColor="{AppThemeBinding Light={StaticResource BtAppBackground},Dark={StaticResource BtDarkBackground}}">
 <ScrollView><VerticalStackLayout Padding="16" Spacing="18" MaximumWidthRequest="1100" HorizontalOptions="Center">
  <VerticalStackLayout Spacing="3"><Label Text="BíbliaTema" Style="{StaticResource BtPageTitleStyle}" SemanticProperties.HeadingLevel="Level1"/><Label Text="Uma palavra para hoje e seus estudos em um só lugar." Style="{StaticResource BtSubtitleStyle}"/></VerticalStackLayout>
  <Grid x:Name="HomeGrid" RowDefinitions="Auto,Auto" ColumnDefinitions="*" RowSpacing="18"><VisualStateManager.VisualStateGroups><VisualStateGroup><VisualState x:Name="Narrow"/><VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="820"/></VisualState.StateTriggers><VisualState.Setters><Setter TargetName="HomeGrid" Property="Grid.ColumnDefinitions" Value="1.15*,0.85*"/><Setter TargetName="QuickPane" Property="Grid.Row" Value="0"/><Setter TargetName="QuickPane" Property="Grid.Column" Value="1"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
   <VerticalStackLayout Grid.Row="0" Spacing="10"><Label Text="Versículo do dia" Style="{StaticResource BtSectionTitleStyle}" SemanticProperties.HeadingLevel="Level2"/>
    <Border Style="{StaticResource BtCardStyle}" StrokeShape="RoundRectangle 16" Padding="20" IsVisible="{Binding HasDailyVerse}"><VerticalStackLayout Spacing="13"><Border BackgroundColor="{StaticResource BtGoldSoft}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="10,5" HorizontalOptions="Start"><Label Text="{Binding DailyVerse.Category}" TextColor="#8A6D00" FontAttributes="Bold" FontSize="12" TextTransform="Uppercase"/></Border><Label Text="{Binding DailyVerse.ReferenceText}" TextColor="{StaticResource BtPrimary}" FontSize="21" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level3"/><Label Text="{Binding DailyVerse.BibleText}" TextColor="{AppThemeBinding Light={StaticResource BtTextPrimary},Dark={StaticResource BtDarkTextPrimary}}" FontSize="19" LineHeight="1.45" LineBreakMode="WordWrap"/><Label Text="{Binding DailyVerse.BibleVersionName, StringFormat='Versão: {0}'}" Style="{StaticResource BtSubtitleStyle}"/><Button Text="Ler capítulo inteiro" Command="{Binding OpenDailyVerseChapterCommand}" Style="{StaticResource BtPrimaryButtonStyle}" FontAutoScalingEnabled="False" SemanticProperties.Hint="Abre o capítulo do versículo no leitor bíblico"/></VerticalStackLayout></Border>
    <Border Style="{StaticResource BtCardStyle}" IsVisible="{Binding IsDailyVerseLoading}"><HorizontalStackLayout Spacing="10"><ActivityIndicator IsRunning="True"/><Label Text="Carregando versículo do dia..." VerticalOptions="Center"/></HorizontalStackLayout></Border>
    <Border Style="{StaticResource BtStatusWarningStyle}" IsVisible="{Binding HasDailyVerseError}"><VerticalStackLayout Spacing="8"><Label Text="{Binding DailyVerseError}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="Tentar novamente" Command="{Binding RetryDailyVerseCommand}" Style="{StaticResource BtSecondaryButtonStyle}"/><Button Grid.Column="1" Text="Gerenciar versões" Command="{Binding OpenVersionsCommand}" Style="{StaticResource BtPrimaryButtonStyle}"/></Grid></VerticalStackLayout></Border>
   </VerticalStackLayout>
   <VerticalStackLayout x:Name="QuickPane" Grid.Row="1" Spacing="10"><Label Text="Acesso rápido" Style="{StaticResource BtSectionTitleStyle}" SemanticProperties.HeadingLevel="Level2"/><FlexLayout Direction="Row" Wrap="Wrap">
    <Border Style="{StaticResource BtCardStyle}" Margin="4" FlexLayout.Basis="47%" FlexLayout.Grow="1"><VerticalStackLayout Spacing="7"><Label Text="B" TextColor="{StaticResource BtPrimary}" FontSize="25" FontAttributes="Bold"/><Label Text="Bíblia" FontAttributes="Bold"/><Label Text="Leia a Palavra" Style="{StaticResource Caption}"/><Button Text="Abrir" Command="{Binding OpenBibleCommand}" Style="{StaticResource BtSecondaryButtonStyle}"/></VerticalStackLayout></Border>
    <Border Style="{StaticResource BtCardStyle}" Margin="4" FlexLayout.Basis="47%" FlexLayout.Grow="1"><VerticalStackLayout Spacing="7"><Label Text="⌕" TextColor="{StaticResource BtPrimary}" FontSize="25" FontAttributes="Bold"/><Label Text="Pesquisar" FontAttributes="Bold"/><Label Text="Encontre passagens" Style="{StaticResource Caption}"/><Button Text="Abrir" Command="{Binding OpenSearchCommand}" Style="{StaticResource BtSecondaryButtonStyle}"/></VerticalStackLayout></Border>
    <Border Style="{StaticResource BtCardStyle}" Margin="4" FlexLayout.Basis="47%" FlexLayout.Grow="1"><VerticalStackLayout Spacing="7"><Label Text="T" TextColor="{StaticResource BtPrimary}" FontSize="25" FontAttributes="Bold"/><Label Text="Temas" FontAttributes="Bold"/><Label Text="Organize assuntos" Style="{StaticResource Caption}"/><Button Text="Abrir" Command="{Binding OpenThemesCommand}" Style="{StaticResource BtSecondaryButtonStyle}"/></VerticalStackLayout></Border>
    <Border Style="{StaticResource BtCardStyle}" Margin="4" FlexLayout.Basis="47%" FlexLayout.Grow="1"><VerticalStackLayout Spacing="7"><Label Text="M" TextColor="{StaticResource BtPrimary}" FontSize="25" FontAttributes="Bold"/><Label Text="Mensagens" FontAttributes="Bold"/><Label Text="Prepare estudos" Style="{StaticResource Caption}"/><Button Text="Abrir" Command="{Binding OpenMessagesCommand}" Style="{StaticResource BtSecondaryButtonStyle}"/></VerticalStackLayout></Border>
    <Border Style="{StaticResource BtCardStyle}" Margin="4" FlexLayout.Basis="47%" FlexLayout.Grow="1"><VerticalStackLayout Spacing="7"><Label Text="R" TextColor="{StaticResource BtPrimary}" FontSize="25" FontAttributes="Bold"/><Label Text="Referências" FontAttributes="Bold"/><Label Text="Consulte seus trechos" Style="{StaticResource Caption}"/><Button Text="Abrir" Command="{Binding OpenReferencesCommand}" Style="{StaticResource BtSecondaryButtonStyle}"/></VerticalStackLayout></Border>
    <Border Style="{StaticResource BtCardStyle}" Margin="4" FlexLayout.Basis="47%" FlexLayout.Grow="1"><VerticalStackLayout Spacing="7"><Label Text="▤" TextColor="{StaticResource BtPrimary}" FontSize="25"/><Label Text="Relatórios" FontAttributes="Bold"/><Label Text="Exporte conteúdo" Style="{StaticResource Caption}"/><Button Text="Abrir" Command="{Binding OpenReportsCommand}" Style="{StaticResource BtSecondaryButtonStyle}"/></VerticalStackLayout></Border>
   </FlexLayout></VerticalStackLayout>
  </Grid>
  <Label Text="Sua biblioteca" Style="{StaticResource BtSectionTitleStyle}" SemanticProperties.HeadingLevel="Level2"/><Border Style="{StaticResource BtCardStyle}"><Grid ColumnDefinitions="*,*,*" ColumnSpacing="8"><VerticalStackLayout><Label Text="{Binding ThemesCount}" TextColor="{StaticResource BtPrimary}" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center"/><Label Text="Temas" Style="{StaticResource Caption}" HorizontalTextAlignment="Center"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="{Binding ReferencesCount}" TextColor="{StaticResource BtPrimary}" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center"/><Label Text="Referências" Style="{StaticResource Caption}" HorizontalTextAlignment="Center"/></VerticalStackLayout><VerticalStackLayout Grid.Column="2"><Label Text="{Binding MessagesCount}" TextColor="{StaticResource BtPrimary}" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center"/><Label Text="Mensagens" Style="{StaticResource Caption}" HorizontalTextAlignment="Center"/></VerticalStackLayout></Grid></Border>
  <Border IsVisible="{Binding HasStatus}" Style="{StaticResource BtStatusWarningStyle}"><Label Text="{Binding Status}"/></Border>
 </VerticalStackLayout></ScrollView>
</ContentPage>
