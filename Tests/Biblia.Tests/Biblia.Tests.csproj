    <Compile Include="..\..\Presentation\ViewModels\ThemesViewModel.cs" Link="Presentation\ViewModels\ThemesViewModel.cs" />
    <Compile Include="..\..\Infrastructure\Media\SkiaVerseCardService.cs" Link="Infrastructure\Media\SkiaVerseCardService.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\Resources\Fonts\OpenSans-Regular.ttf" LogicalName="Biblia.Fonts.OpenSans-Regular.ttf" />
    <EmbeddedResource Include="..\..\Resources\Fonts\OpenSans-Semibold.ttf" LogicalName="Biblia.Fonts.OpenSans-Semibold.ttf" />
  </ItemGroup>
</Project>
