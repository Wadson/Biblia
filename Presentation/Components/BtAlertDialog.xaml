<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Biblia.Presentation.Components.BtAlertDialog" x:Name="Root" IsVisible="{Binding IsOpen,Source={x:Reference Root}}"><Grid BackgroundColor="{StaticResource BtOverlay}" Padding="24"><Border Style="{StaticResource BtCardStyle}" StrokeShape="RoundRectangle 20" Padding="20" VerticalOptions="Center" MaximumWidthRequest="480"><VerticalStackLayout Spacing="14"><Label Text="{Binding Title,Source={x:Reference Root}}" Style="{StaticResource BtSectionTitleStyle}"/><Label Text="{Binding Message,Source={x:Reference Root}}" Style="{StaticResource BtSubtitleStyle}"/><Button Text="Entendi" Command="{Binding CloseCommand,Source={x:Reference Root}}"/></VerticalStackLayout></Border></Grid></ContentView>
