<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Biblia.Presentation.Components.BtLoadingOverlay" x:Name="Root" IsVisible="{Binding IsBusy,Source={x:Reference Root}}"><Grid BackgroundColor="{StaticResource BtOverlaySoft}"><Border Style="{StaticResource BtCardStyle}" StrokeShape="RoundRectangle 16" Padding="24" HorizontalOptions="Center" VerticalOptions="Center"><VerticalStackLayout Spacing="12"><ActivityIndicator IsRunning="{Binding IsBusy,Source={x:Reference Root}}"/><Label Text="{Binding Message,Source={x:Reference Root}}" Style="{StaticResource BtSubtitleStyle}"/></VerticalStackLayout></Border></Grid></ContentView>
