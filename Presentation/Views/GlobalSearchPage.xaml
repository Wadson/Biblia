<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Biblia.Presentation.Views.GlobalSearchPage" Title="Pesquisa global"><Grid Padding="16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10"><Label Text="Pesquisa global" Style="{StaticResource PageTitle}" SemanticProperties.HeadingLevel="Level1"/><FlexLayout Grid.Row="1" Direction="Row" Wrap="Wrap"><Entry FlexLayout.Basis="100%" Placeholder="Bíblia, temas e referências" Text="{Binding Text}"/><Button FlexLayout.Basis="48%" Text="Pesquisar" Command="{Binding SearchCommand}"/><Button FlexLayout.Basis="48%" Text="Limpar" Command="{Binding ClearCommand}"/></FlexLayout><CollectionView Grid.Row="2" ItemsSource="{Binding Items}"><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource AppCard}" Margin="0,4"><VerticalStackLayout><Label Text="{Binding Kind}" Style="{StaticResource BodySecondary}"/><Label Text="{Binding Title}" FontAttributes="Bold"/><Label Text="{Binding Summary}" LineBreakMode="WordWrap"/></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate><CollectionView.EmptyView><Label Text="{Binding Status}"/></CollectionView.EmptyView></CollectionView><VerticalStackLayout Grid.Row="3"><ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/><Label Text="{Binding Status}"/></VerticalStackLayout></Grid></ContentPage>
