<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Biblia.Presentation.Views.MessageDuplicationPage" Title="Duplicar mensagem"><VerticalStackLayout Padding="16" Spacing="12"><Label Text="Duplicar mensagem" Style="{StaticResource PageTitle}" SemanticProperties.HeadingLevel="Level1"/><Label Text="Mensagem de origem" Style="{StaticResource FieldLabel}"/><CollectionView HeightRequest="52" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="6"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource AppCard}" Padding="10,5"><Label Text="{Binding Title}"/></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView><Entry Placeholder="Novo título (opcional)" Text="{Binding Title}"/><Button Text="Duplicar mensagem" Command="{Binding DuplicateCommand}"/><Label Text="{Binding Status}"/></VerticalStackLayout></ContentPage>
