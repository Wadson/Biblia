<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:components="clr-namespace:Biblia.Presentation.Components" x:Class="Biblia.Presentation.Views.MessageDuplicationPage" Title="Duplicar mensagem" BackgroundColor="{StaticResource BtAppBackground}" Shell.BackgroundColor="{StaticResource BtHeader}" Shell.TitleColor="White">
 <Shell.BackButtonBehavior><BackButtonBehavior IsVisible="False" IsEnabled="True"/></Shell.BackButtonBehavior>
 <Shell.TitleView><components:PageHeaderView Title="Duplicar mensagem"/></Shell.TitleView>
 <ScrollView><VerticalStackLayout Padding="16" Spacing="12" MaximumWidthRequest="720" HorizontalOptions="Center"><Label Text="Duplicar mensagem" Style="{StaticResource BtPageTitleStyle}"/><Border Style="{StaticResource BtCardStyle}"><VerticalStackLayout Spacing="10"><Label Text="Mensagem de origem" Style="{StaticResource FieldLabel}"/><CollectionView HeightRequest="58" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}" SelectionMode="Single"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="6"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource BtMenuItemStyle}" Padding="12,7"><Label Text="{Binding Title}"/></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView><Border Style="{StaticResource BtEntryContainerStyle}"><Entry Placeholder="Novo título (opcional)" Text="{Binding Title}"/></Border><Button Text="Duplicar mensagem" Style="{StaticResource BtPrimaryButtonStyle}" Command="{Binding DuplicateCommand}"/></VerticalStackLayout></Border><Border Style="{StaticResource BtStatusInfoStyle}"><Label Text="{Binding Status}" Style="{StaticResource BtSubtitleStyle}"/></Border></VerticalStackLayout></ScrollView>
</ContentPage>
