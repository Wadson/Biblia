<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Biblia.Presentation.Views.SettingsPage" Title="Configurações">
 <ScrollView><VerticalStackLayout Padding="16" Spacing="14" MaximumWidthRequest="820" HorizontalOptions="Center">
  <VerticalStackLayout Spacing="2"><Label Text="Configurações" Style="{StaticResource PageTitle}"/><Label Text="Personalize sua experiência e proteja seus dados." Style="{StaticResource BodySecondary}"/></VerticalStackLayout>
  <Border Style="{StaticResource AppCard}"><VerticalStackLayout Spacing="12"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><Border WidthRequest="42" HeightRequest="42" BackgroundColor="{StaticResource Selected}" StrokeThickness="0"><Label Text="◐" TextColor="{StaticResource Primary}" FontSize="20" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border><VerticalStackLayout Grid.Column="1"><Label Text="Aparência" Style="{StaticResource SectionTitle}"/><Label Text="Escolha o tema mais confortável para leitura." Style="{StaticResource Caption}"/></VerticalStackLayout></Grid><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Modo escuro" FontAttributes="Bold"/><Label Text="Reduz o brilho em ambientes com pouca luz." Style="{StaticResource Caption}"/></VerticalStackLayout><Switch Grid.Column="1" IsToggled="{Binding DarkMode}"/></Grid><Button Text="Salvar preferência" Command="{Binding SaveCommand}"/></VerticalStackLayout></Border>
  <Border Style="{StaticResource AppCard}"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><Border WidthRequest="42" HeightRequest="42" BackgroundColor="{StaticResource Selected}" StrokeThickness="0"><Label Text="▤" TextColor="{StaticResource Primary}" FontSize="20" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border><VerticalStackLayout Grid.Column="1"><Label Text="Versões instaladas" Style="{StaticResource SectionTitle}"/><Label Text="Gerencie downloads, disponibilidade e a versão bíblica padrão na tela Versões." Style="{StaticResource BodySecondary}"/></VerticalStackLayout></Grid></Border>
  <Border Style="{StaticResource AppCard}"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><Border WidthRequest="42" HeightRequest="42" BackgroundColor="{StaticResource Selected}" StrokeThickness="0"><Label Text="↥" TextColor="{StaticResource Primary}" FontSize="20" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border><VerticalStackLayout Grid.Column="1"><Label Text="Backup e restauração" Style="{StaticResource SectionTitle}"/><Label Text="Protege mensagens, temas, referências e preferências; os bancos bíblicos permanecem separados." Style="{StaticResource BodySecondary}"/></VerticalStackLayout></Grid></Border>
  <Border Style="{StaticResource AppCard}"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><Border WidthRequest="42" HeightRequest="42" BackgroundColor="{StaticResource Selected}" StrokeThickness="0"><Label Text="i" TextColor="{StaticResource Primary}" FontAttributes="Bold" FontSize="20" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/></Border><VerticalStackLayout Grid.Column="1"><Label Text="Sobre" Style="{StaticResource SectionTitle}"/><Label Text="Bíblia Tema • .NET 10" Style="{StaticResource BodySecondary}"/><Label Text="Estudo bíblico, referências e preparação de mensagens." Style="{StaticResource Caption}"/></VerticalStackLayout></Grid></Border>
  <Label Text="{Binding Status}" Style="{StaticResource BodySecondary}"/>
 </VerticalStackLayout></ScrollView>
</ContentPage>
