<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:components="clr-namespace:Biblia.Presentation.Components" x:Class="Biblia.Presentation.Views.SettingsPage" Title="Configurações" BackgroundColor="{StaticResource BtAppBackground}" Shell.BackgroundColor="{StaticResource BtHeader}" Shell.TitleColor="White">
 <Shell.TitleView><components:PageHeaderView Title="Configurações" FallbackRoute="//Home"/></Shell.TitleView>
 <Grid><ScrollView><VerticalStackLayout Padding="16" Spacing="14" MaximumWidthRequest="900" HorizontalOptions="Center">
  <VerticalStackLayout Spacing="3"><Label Text="Configurações" Style="{StaticResource BtPageTitleStyle}"/><Label Text="Personalize sua experiência e proteja seus dados." Style="{StaticResource BtSubtitleStyle}"/></VerticalStackLayout>
  <Border Style="{StaticResource BtCardStyle}"><VerticalStackLayout Spacing="12"><Label Text="Aparência" Style="{StaticResource BtSectionTitleStyle}"/><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Modo escuro" FontAttributes="Bold"/><Label Text="Reduz o brilho em ambientes com pouca luz." Style="{StaticResource Caption}"/></VerticalStackLayout><Switch Grid.Column="1" IsToggled="{Binding DarkMode}"/></Grid><Button Text="Salvar preferência" Style="{StaticResource BtPrimaryButtonStyle}" Command="{Binding SaveCommand}"/></VerticalStackLayout></Border>
  <Border Style="{StaticResource BtCardStyle}"><VerticalStackLayout Spacing="10"><Label Text="Versões instaladas" Style="{StaticResource BtSectionTitleStyle}"/><Label Text="{Binding InstalledVersionsDescription}" Style="{StaticResource BtSubtitleStyle}"/><CollectionView ItemsSource="{Binding InstalledVersions}" HeightRequest="230" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource BtMenuItemStyle}" Margin="0,3" Padding="11,8"><Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="True"><Setter Property="BackgroundColor" Value="{StaticResource BtSelectedBackground}"/><Setter Property="Stroke" Value="{StaticResource BtSelectedBorder}"/></DataTrigger></Border.Triggers><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><Label Text="●" TextColor="{StaticResource BtPrimary}" VerticalOptions="Center"/><VerticalStackLayout Grid.Column="1"><Label Text="{Binding Code}" FontAttributes="Bold" TextColor="{StaticResource BtPrimary}"/><Label Text="{Binding DisplayName}" Style="{StaticResource Caption}"/></VerticalStackLayout><Border Grid.Column="2" Style="{StaticResource BtBadgeStyle}" IsVisible="{Binding IsActive}"><Label Text="Atual" TextColor="{StaticResource BtPrimary}" FontAttributes="Bold" FontSize="12"/></Border></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView><Button Text="Gerenciar versões" Style="{StaticResource BtSecondaryButtonStyle}" Command="{Binding OpenVersionsCommand}" SemanticProperties.Hint="Abre a tela completa de versões bíblicas"/></VerticalStackLayout></Border>
  <Border Style="{StaticResource BtCardStyle}"><VerticalStackLayout Spacing="10"><Label Text="Backup e restauração" Style="{StaticResource BtSectionTitleStyle}"/><Label Text="Proteja temas, referências, comentários, mensagens e preferências." Style="{StaticResource BtSubtitleStyle}"/><Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="8" ColumnSpacing="8"><Button Text="Salvar uma cópia..." Style="{StaticResource BtPrimaryButtonStyle}" Command="{Binding SaveBackupAsCommand}" FontSize="13" FontAutoScalingEnabled="False" SemanticProperties.Hint="Cria o backup e abre o gerenciador de arquivos para escolher onde salvar"/><Button Grid.Column="1" Text="Compartilhar" Style="{StaticResource BtSecondaryButtonStyle}" Command="{Binding ShareBackupCommand}" FontSize="13" FontAutoScalingEnabled="False"/><Button Grid.Row="1" Grid.ColumnSpan="2" Text="Restaurar backup..." Style="{StaticResource BtDangerButtonStyle}" Command="{Binding RestoreBackupCommand}"/></Grid><Border Style="{StaticResource BtStatusInfoStyle}" IsVisible="{Binding HasBackup}"><VerticalStackLayout><Label Text="Backup gerado nesta sessão" Style="{StaticResource FieldLabel}"/><Label Text="{Binding LastBackupDescription}" Style="{StaticResource BtSubtitleStyle}"/></VerticalStackLayout></Border><Label Text="Salvar abre o gerenciador de arquivos. Compartilhar envia pelo WhatsApp, Telegram, e-mail ou outro aplicativo." Style="{StaticResource Caption}"/></VerticalStackLayout></Border>
  <Border Style="{StaticResource BtCardStyle}"><VerticalStackLayout Spacing="8"><Label Text="Sobre" Style="{StaticResource BtSectionTitleStyle}"/><Label Text="BíbliaTema Premium Edition" Style="{StaticResource BtSubtitleStyle}"/><Button Text="Abrir informações do aplicativo" Style="{StaticResource BtSecondaryButtonStyle}" Command="{Binding OpenAboutCommand}" SemanticProperties.Hint="Mostra versão, autoria e tecnologias"/></VerticalStackLayout></Border>
  <Border Style="{StaticResource BtStatusInfoStyle}"><Label Text="{Binding Status}" Style="{StaticResource BtSubtitleStyle}"/></Border>
 </VerticalStackLayout></ScrollView>
 <Grid BackgroundColor="{StaticResource BtOverlay}" IsVisible="{Binding RestoreConfirmationVisible}" ZIndex="100"><Border Style="{StaticResource BtStatusErrorStyle}" Margin="22" Padding="18" VerticalOptions="Center" MaximumWidthRequest="520"><VerticalStackLayout Spacing="12"><Label Text="Restaurar backup?" Style="{StaticResource BtSectionTitleStyle}"/><Label Text="Os dados atuais do usuário serão substituídos. O aplicativo criará uma cópia de segurança antes da restauração."/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="Cancelar" Style="{StaticResource BtSecondaryButtonStyle}" Command="{Binding CancelRestoreCommand}"/><Button Grid.Column="1" Text="Restaurar" Style="{StaticResource BtDangerButtonStyle}" Command="{Binding ConfirmRestoreCommand}"/></Grid></VerticalStackLayout></Border></Grid>
 <Grid BackgroundColor="{StaticResource BtOverlay}" IsVisible="{Binding AboutVisible}" ZIndex="110"><Border Style="{StaticResource BtCardStyle}" Margin="22" Padding="22" VerticalOptions="Center" MaximumWidthRequest="520"><VerticalStackLayout Spacing="10"><Label Text="BíbliaTema" Style="{StaticResource BtPageTitleStyle}"/><Label Text="Premium Edition" TextColor="{StaticResource BtGold}" FontAttributes="Bold"/><Label Text="© Copyright 2026"/><Label Text="Desenvolvido por" Style="{StaticResource Caption}"/><Label Text="WR Soft Serviços OnLine" FontAttributes="Bold"/><Label Text="wadsonsoft@gmail.com" TextColor="{StaticResource BtPrimary}" FontAttributes="Bold"/><Label Text="Todos os direitos reservados."/><BoxView HeightRequest="1" Color="{StaticResource BtBorder}"/><Label Text="{Binding AppVersion}"/><Label Text="{Binding AppBuild}" Style="{StaticResource Caption}"/><Label Text="Tecnologia" FontAttributes="Bold"/><Label Text=".NET MAUI • .NET 10 • C# • SQLite" Style="{StaticResource BtSubtitleStyle}"/><Button Text="Fechar" Style="{StaticResource BtPrimaryButtonStyle}" Command="{Binding CloseAboutCommand}"/></VerticalStackLayout></Border></Grid>
 <Grid BackgroundColor="{StaticResource BtOverlaySoft}" IsVisible="{Binding IsBusy}" ZIndex="200"><Border Style="{StaticResource BtCardStyle}" HorizontalOptions="Center" VerticalOptions="Center"><HorizontalStackLayout Spacing="10"><ActivityIndicator IsRunning="True"/><Label Text="Processando..." VerticalOptions="Center"/></HorizontalStackLayout></Border></Grid>
 </Grid>
</ContentPage>
