<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:components="clr-namespace:Biblia.Presentation.Components" x:Class="Biblia.Presentation.Views.BibleVersionsPage" Title="Versões da Bíblia" BackgroundColor="{StaticResource BtAppBackground}" Shell.BackgroundColor="{StaticResource BtHeader}" Shell.TitleColor="White">
 <Shell.TitleView><components:PageHeaderView Title="Versões da Bíblia" FallbackRoute="//Home"/></Shell.TitleView>
 <ContentPage.Resources><Style x:Key="DefaultVersionButtonStyle" TargetType="Button" BasedOn="{StaticResource BtPrimaryButtonStyle}"><Setter Property="BackgroundColor" Value="{StaticResource BtGold}"/><Setter Property="TextColor" Value="{StaticResource BtTextPrimary}"/></Style></ContentPage.Resources>
 <Grid Padding="16" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12" MaximumWidthRequest="900" HorizontalOptions="Center">
  <VerticalStackLayout Grid.Row="0" Spacing="10"><VerticalStackLayout Spacing="3"><Label Text="Versões da Bíblia" Style="{StaticResource BtPageTitleStyle}" FontAutoScalingEnabled="False"/><Label Text="Gerencie traduções instaladas e importe bancos SQLite compatíveis." Style="{StaticResource BtSubtitleStyle}"/></VerticalStackLayout><Button Text="＋ Adicionar versão" Style="{StaticResource BtPrimaryButtonStyle}" Command="{Binding AddCommand}" HorizontalOptions="Fill" FontSize="14" FontAutoScalingEnabled="False"/></VerticalStackLayout>
  <CollectionView Grid.Row="1" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" SelectionMode="Single"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><Grid><VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="SelectionStates"><VisualState x:Name="Normal"><VisualState.Setters><Setter TargetName="VersionCard" Property="Border.BackgroundColor" Value="#FFFFFF"/><Setter TargetName="VersionCard" Property="Border.Stroke" Value="#E0E0E0"/><Setter TargetName="VersionName" Property="Label.TextColor" Value="#0A0A0A"/></VisualState.Setters></VisualState><VisualState x:Name="Selected"><VisualState.Setters><Setter TargetName="VersionCard" Property="Border.BackgroundColor" Value="#E4EDF7"/><Setter TargetName="VersionCard" Property="Border.Stroke" Value="#B8D4F0"/><Setter TargetName="VersionName" Property="Label.TextColor" Value="#0066CC"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups><Border x:Name="VersionCard" Style="{StaticResource BtCardStyle}" Padding="14"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="5"><Label x:Name="VersionName" Text="{Binding DisplayName}" FontSize="17" FontAttributes="Bold" LineBreakMode="TailTruncation"/><Border Grid.Column="1" Style="{StaticResource BtBadgeStyle}"><Label Text="{Binding Code}" TextColor="{StaticResource BtPrimary}" FontAttributes="Bold"/></Border><Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ValidationStatus}" Style="{StaticResource BtSubtitleStyle}"/><HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="8"><Label Text="Instalada" FontSize="12" TextColor="{StaticResource BtTextSecondary}"/><Label Text="●" FontSize="11" TextColor="{StaticResource BtPrimary}"/><Label Text="{Binding IsEnabled, StringFormat='Ativa: {0}'}" FontSize="12" TextColor="{StaticResource BtTextSecondary}"/></HorizontalStackLayout></Grid></Border></Grid></DataTemplate></CollectionView.ItemTemplate><CollectionView.EmptyView><Border Style="{StaticResource BtCardStyle}" Margin="0,8"><VerticalStackLayout Spacing="4"><Label Text="Nenhuma versão no catálogo." FontAttributes="Bold"/><Label Text="Use Adicionar para importar uma versão compatível." Style="{StaticResource BtSubtitleStyle}"/></VerticalStackLayout></Border></CollectionView.EmptyView></CollectionView>
  <Border Grid.Row="2" Style="{StaticResource BtCardStyle}" Padding="12"><Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="8" ColumnSpacing="8"><Label Grid.ColumnSpan="2" Text="Ações da versão selecionada" Style="{StaticResource FieldLabel}"/><Button Grid.Row="1" Text="Validar" Style="{StaticResource BtSecondaryButtonStyle}" Command="{Binding ValidateCommand}" FontSize="13" FontAutoScalingEnabled="False"/><Button Grid.Row="1" Grid.Column="1" Text="Ativar / desativar" Style="{StaticResource BtPrimaryButtonStyle}" Command="{Binding ToggleCommand}" FontSize="13" FontAutoScalingEnabled="False"/><Button Grid.Row="2" Text="Definir como padrão" Style="{StaticResource DefaultVersionButtonStyle}" Command="{Binding SetDefaultCommand}" FontSize="13" FontAutoScalingEnabled="False"/><Button Grid.Row="2" Grid.Column="1" Text="Remover importada" Style="{StaticResource BtDangerButtonStyle}" Command="{Binding RemoveCommand}" FontSize="13" FontAutoScalingEnabled="False"><Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding SelectedVersion.IsBundled}" Value="True"><Setter Property="BackgroundColor" Value="{StaticResource BtDisabledBackground}"/><Setter Property="TextColor" Value="{StaticResource BtDisabledText}"/><Setter Property="BorderColor" Value="{StaticResource BtBorder}"/></DataTrigger></Button.Triggers></Button></Grid></Border>
  <Border Grid.Row="3" Style="{StaticResource BtStatusInfoStyle}"><Label Text="{Binding Status}" Style="{StaticResource BtSubtitleStyle}" SemanticProperties.Description="Status da operação"/></Border>
  <Grid Grid.RowSpan="4" BackgroundColor="{StaticResource BtOverlaySoft}" IsVisible="{Binding IsBusy}" ZIndex="100"><Border Style="{StaticResource BtCardStyle}" HorizontalOptions="Center" VerticalOptions="Center"><HorizontalStackLayout Spacing="10"><ActivityIndicator IsRunning="True"/><Label Text="Processando versão..." VerticalOptions="Center"/></HorizontalStackLayout></Border></Grid>
 </Grid>
</ContentPage>
