<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:components="clr-namespace:Biblia.Presentation.Components" x:Class="Biblia.Presentation.Views.MessageTopicsPage" Title="Tópicos" Style="{StaticResource BtPageStyle}" Shell.BackgroundColor="{StaticResource BtHeader}" Shell.TitleColor="White">
 <Grid>
  <ScrollView><VerticalStackLayout Padding="16" Spacing="16" MaximumWidthRequest="1080" HorizontalOptions="Center">
   <Border Style="{StaticResource BtCardStyle}" Padding="14"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><VerticalStackLayout><Label Text="Mensagem" Style="{StaticResource FieldLabel}"/><Label Text="{Binding MessageTitle}" FontSize="18" FontAttributes="Bold"/><Label Text="{Binding MessageType}" Style="{StaticResource BtSubtitleStyle}"/></VerticalStackLayout><Button Grid.Column="1" Text="Selecionar mensagem" Style="{StaticResource BtCompactButtonStyle}" Command="{Binding SelectMessageCommand}"><Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding HasMessage}" Value="True"><Setter Property="IsVisible" Value="False"/></DataTrigger></Button.Triggers></Button></Grid></Border>
   <CollectionView ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}" SelectionMode="Single" HeightRequest="48" IsVisible="{Binding HasMessage}"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><components:BtSelectableChip Text="{Binding Title}"/></DataTemplate></CollectionView.ItemTemplate></CollectionView>

   <Grid x:Name="TopicsGrid" ColumnDefinitions="*" RowDefinitions="Auto,Auto" RowSpacing="16"><VisualStateManager.VisualStateGroups><VisualStateGroup><VisualState x:Name="Narrow"/><VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="760"/></VisualState.StateTriggers><VisualState.Setters><Setter TargetName="TopicsGrid" Property="Grid.ColumnDefinitions" Value="0.9*,1.1*"/><Setter TargetName="EditorPane" Property="Grid.Row" Value="0"/><Setter TargetName="EditorPane" Property="Grid.Column" Value="1"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
    <VerticalStackLayout Grid.Row="0" Spacing="10"><Label Text="Tópicos da mensagem" Style="{StaticResource BtSectionTitleStyle}"/><CollectionView ItemsSource="{Binding Topics}" SelectedItem="{Binding SelectedTopic}" SelectionMode="Single" HeightRequest="410"><CollectionView.ItemTemplate><DataTemplate><Grid Margin="0,4"><VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="SelectionStates"><VisualState x:Name="Normal"><VisualState.Setters><Setter TargetName="TopicCard" Property="Border.BackgroundColor" Value="{StaticResource BtSurface}"/><Setter TargetName="TopicCard" Property="Border.Stroke" Value="{StaticResource BtBorder}"/><Setter TargetName="TopicTitle" Property="Label.TextColor" Value="{StaticResource BtTextPrimary}"/></VisualState.Setters></VisualState><VisualState x:Name="Selected"><VisualState.Setters><Setter TargetName="TopicCard" Property="Border.BackgroundColor" Value="{StaticResource BtSelectedBackground}"/><Setter TargetName="TopicCard" Property="Border.Stroke" Value="{StaticResource BtSelectedBorder}"/><Setter TargetName="TopicTitle" Property="Label.TextColor" Value="{StaticResource BtPrimary}"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups><Border x:Name="TopicCard" Style="{StaticResource BtCardStyle}" Padding="14"><VerticalStackLayout Spacing="5"><Label x:Name="TopicTitle" Text="{Binding Title}" FontAttributes="Bold" FontSize="17"/><Label Text="{Binding Content}" MaxLines="3" Style="{StaticResource BtSubtitleStyle}"/></VerticalStackLayout></Border></Grid></DataTemplate></CollectionView.ItemTemplate><CollectionView.EmptyView><Border Style="{StaticResource BtCardStyle}" Margin="0,8"><VerticalStackLayout><Label Text="Nenhum tópico cadastrado." FontAttributes="Bold"/><Label Text="Crie o primeiro tópico no formulário ao lado." Style="{StaticResource BtSubtitleStyle}"/></VerticalStackLayout></Border></CollectionView.EmptyView></CollectionView></VerticalStackLayout>
    <VerticalStackLayout x:Name="EditorPane" Grid.Row="1" Spacing="10"><Border Style="{StaticResource BtCardStyle}"><VerticalStackLayout Spacing="10"><Label Text="{Binding EditorTitle}" Style="{StaticResource BtSectionTitleStyle}"/><Label Text="Título do tópico" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource BtEntryContainerStyle}"><Entry Placeholder="Ex.: Introdução" Text="{Binding Title}"/></Border><Label Text="Conteúdo" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource BtEditorContainerStyle}"><Editor Placeholder="Desenvolva o conteúdo deste tópico..." Text="{Binding Content}" MinimumHeightRequest="160" AutoSize="TextChanges"/></Border><Label Text="{Binding RequirementText}" Style="{StaticResource BtSubtitleStyle}"/><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8"><Button Text="Novo" Style="{StaticResource BtSecondaryButtonStyle}" Command="{Binding NewCommand}"/><Button Grid.Column="1" Text="Salvar tópico" Style="{StaticResource BtPrimaryButtonStyle}" Command="{Binding SaveCommand}"/><Button Grid.Row="1" Text="Excluir" Style="{StaticResource BtDangerButtonStyle}" Command="{Binding DeleteCommand}"/><Button Grid.Row="1" Grid.Column="1" Text="Mover acima" Style="{StaticResource BtSecondaryButtonStyle}" Command="{Binding UpCommand}"/><Button Grid.Row="2" Grid.ColumnSpan="2" Text="Mover abaixo" Style="{StaticResource BtSecondaryButtonStyle}" Command="{Binding DownCommand}"/></Grid></VerticalStackLayout></Border><Border Style="{StaticResource BtStatusInfoStyle}"><Label Text="{Binding Status}" Style="{StaticResource BtSubtitleStyle}"/></Border></VerticalStackLayout>
   </Grid>
  </VerticalStackLayout></ScrollView>
  <Grid BackgroundColor="{StaticResource BtOverlaySoft}" IsVisible="{Binding IsBusy}" ZIndex="100"><Border Style="{StaticResource BtCardStyle}" HorizontalOptions="Center" VerticalOptions="Center"><HorizontalStackLayout Spacing="10"><ActivityIndicator IsRunning="True"/><Label Text="Salvando tópico..." VerticalOptions="Center"/></HorizontalStackLayout></Border></Grid>
 </Grid>
</ContentPage>
