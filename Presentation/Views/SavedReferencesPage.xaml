<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:components="clr-namespace:Biblia.Presentation.Components" x:Class="Biblia.Presentation.Views.SavedReferencesPage" Title="Minhas referências" BackgroundColor="{StaticResource BtAppBackground}">
 <Shell.TitleView><components:PageHeaderView Title="Minhas referências" FallbackRoute="//Home"/></Shell.TitleView>
 <Grid><ScrollView><VerticalStackLayout Padding="16" Spacing="14" MaximumWidthRequest="1100" HorizontalOptions="Center">
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><VerticalStackLayout><Label Text="Minhas referências" Style="{StaticResource BtPageTitleStyle}" FontAutoScalingEnabled="False"/><Label Text="Trechos, comentários permanentes e temas." Style="{StaticResource BtSubtitleStyle}"/></VerticalStackLayout><Button Grid.Column="1" Text="＋ Nova" Style="{StaticResource BtPrimaryButtonStyle}" Command="{Binding NewCommand}" FontSize="14" FontAutoScalingEnabled="False" VerticalOptions="Center"/></Grid>
  <Border Style="{StaticResource BtCardStyle}" Padding="12"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Border Style="{StaticResource BtSearchContainerStyle}"><Entry Placeholder="Pesquisar referência ou comentário" Text="{Binding SearchText}" ReturnType="Search" ReturnCommand="{Binding SearchCommand}"/></Border><Button Grid.Column="1" Text="Pesquisar" Style="{StaticResource BtPrimaryButtonStyle}" Command="{Binding SearchCommand}" FontSize="13" FontAutoScalingEnabled="False"/></Grid></Border>
  <Grid x:Name="ReferencesGrid" RowDefinitions="Auto,Auto" ColumnDefinitions="*" RowSpacing="14"><VisualStateManager.VisualStateGroups><VisualStateGroup><VisualState x:Name="Narrow"/><VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="820"/></VisualState.StateTriggers><VisualState.Setters><Setter TargetName="ReferencesGrid" Property="Grid.ColumnDefinitions" Value="0.8*,1.2*"/><Setter TargetName="EditorPane" Property="Grid.Row" Value="0"/><Setter TargetName="EditorPane" Property="Grid.Column" Value="1"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
   <VerticalStackLayout Grid.Row="0" Spacing="8"><Label Text="Referências salvas" Style="{StaticResource BtSectionTitleStyle}"/><CollectionView HeightRequest="300" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" SelectionMode="Single"><CollectionView.ItemTemplate><DataTemplate><Grid Margin="0,4"><VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="SelectionStates"><VisualState x:Name="Normal"><VisualState.Setters><Setter TargetName="ReferenceCard" Property="Border.BackgroundColor" Value="#FFFFFF"/><Setter TargetName="ReferenceCard" Property="Border.Stroke" Value="#E0E0E0"/><Setter TargetName="ReferenceTitle" Property="Label.TextColor" Value="#0A0A0A"/></VisualState.Setters></VisualState><VisualState x:Name="Selected"><VisualState.Setters><Setter TargetName="ReferenceCard" Property="Border.BackgroundColor" Value="#E4EDF7"/><Setter TargetName="ReferenceCard" Property="Border.Stroke" Value="#B8D4F0"/><Setter TargetName="ReferenceTitle" Property="Label.TextColor" Value="#0066CC"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups><Border x:Name="ReferenceCard" Style="{StaticResource BtCardStyle}" Padding="13"><VerticalStackLayout Spacing="4"><Label x:Name="ReferenceTitle" Text="{Binding DisplayReference}" FontAttributes="Bold" FontSize="17"/><Label Text="{Binding Themes}" Style="{StaticResource BtSubtitleStyle}"/><Label Text="{Binding Comment}" MaxLines="2" Style="{StaticResource Caption}"/></VerticalStackLayout></Border></Grid></DataTemplate></CollectionView.ItemTemplate><CollectionView.EmptyView><Border Style="{StaticResource BtCardStyle}" Margin="0,6"><VerticalStackLayout><Label Text="Nenhuma referência encontrada." FontAttributes="Bold"/><Label Text="Crie uma referência no formulário abaixo." Style="{StaticResource BtSubtitleStyle}"/></VerticalStackLayout></Border></CollectionView.EmptyView></CollectionView></VerticalStackLayout>
   <VerticalStackLayout x:Name="EditorPane" Grid.Row="1" Spacing="10"><Border Style="{StaticResource BtCardStyle}"><VerticalStackLayout Spacing="10"><Label Text="{Binding EditorTitle}" Style="{StaticResource BtSectionTitleStyle}"/>
    <Label Text="Versão bíblica" Style="{StaticResource FieldLabel}"/><CollectionView HeightRequest="48" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" SelectionMode="Single" SelectionChanged="OnVersionChanged"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="7"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><components:BtSelectableChip Text="{Binding Code}"/></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Label Text="Livro" Style="{StaticResource FieldLabel}"/><CollectionView HeightRequest="48" ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook}" SelectionMode="Single" SelectionChanged="OnBookChanged"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="7"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><components:BtSelectableChip Text="{Binding Name}"/></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Label Text="Capítulo" Style="{StaticResource FieldLabel}"/><CollectionView HeightRequest="48" ItemsSource="{Binding Chapters}" SelectedItem="{Binding SelectedChapter}" SelectionMode="Single" SelectionChanged="OnChapterChanged"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="7"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><components:BtSelectableChip Text="{Binding .}"/></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="10"><VerticalStackLayout Spacing="6"><Label Text="Versículo inicial" Style="{StaticResource FieldLabel}"/><CollectionView HeightRequest="48" ItemsSource="{Binding Verses}" SelectedItem="{Binding VerseStart}" SelectionMode="Single" SelectionChanged="OnVerseChanged"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="6"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><components:BtSelectableChip Text="{Binding .}"/></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="6"><Label Text="Versículo final" Style="{StaticResource FieldLabel}"/><CollectionView HeightRequest="48" ItemsSource="{Binding Verses}" SelectedItem="{Binding VerseEnd}" SelectionMode="Single" SelectionChanged="OnVerseChanged"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="6"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><components:BtSelectableChip Text="{Binding .}"/></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout></Grid>
    <Border Style="{StaticResource BtStatusInfoStyle}"><Label Text="{Binding FormattedReference}" TextColor="{StaticResource BtPrimary}" FontAttributes="Bold" FontSize="16"/></Border>
    <Label Text="Texto bíblico" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource BtCardStyle}" Padding="12" Shadow="{x:Null}"><Label Text="{Binding PreviewText}" LineBreakMode="WordWrap"/></Border>
    <Label Text="Comentário permanente" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource BtEditorContainerStyle}"><Editor Text="{Binding Comment}" Placeholder="Anotação reutilizada sempre que esta referência for consultada." MinimumHeightRequest="90" AutoSize="TextChanges"/></Border>
    <Label Text="Temas relacionados" Style="{StaticResource FieldLabel}"/><CollectionView ItemsSource="{Binding Themes}" HeightRequest="150"><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource BtMenuItemStyle}" Margin="0,3" Padding="10,6"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><CheckBox IsChecked="{Binding IsSelected}" Color="{StaticResource BtPrimary}"/><Label Grid.Column="1" Text="{Binding Name}" VerticalTextAlignment="Center"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="Salvar referência" Style="{StaticResource BtPrimaryButtonStyle}" Command="{Binding SaveCommand}" FontSize="13" FontAutoScalingEnabled="False"/><Button Grid.Column="1" Text="Excluir" Style="{StaticResource BtDangerButtonStyle}" Command="{Binding DeleteCommand}" FontSize="13" FontAutoScalingEnabled="False"/></Grid>
   </VerticalStackLayout></Border><Border Style="{StaticResource BtStatusInfoStyle}"><Label Text="{Binding Status}" Style="{StaticResource BtSubtitleStyle}"/></Border></VerticalStackLayout>
  </Grid>
 </VerticalStackLayout></ScrollView>
 <Grid BackgroundColor="{StaticResource BtOverlaySoft}" IsVisible="{Binding IsBusy}" ZIndex="100"><Border Style="{StaticResource BtCardStyle}" HorizontalOptions="Center" VerticalOptions="Center"><HorizontalStackLayout Spacing="10"><ActivityIndicator IsRunning="True"/><Label Text="Carregando referência..." VerticalOptions="Center"/></HorizontalStackLayout></Border></Grid></Grid>
</ContentPage>
