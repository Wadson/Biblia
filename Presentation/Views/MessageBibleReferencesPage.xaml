<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Biblia.Presentation.Components"
             x:Class="Biblia.Presentation.Views.MessageBibleReferencesPage"
             x:Name="Root"
             Title="Vinculação de Temas"
             Style="{StaticResource BtPageStyle}"
             Shell.BackgroundColor="{StaticResource BtHeader}"
             Shell.TitleColor="White">
 <Shell.TitleView><components:PageHeaderView Title="Vinculação de Temas" FallbackRoute="//Home"/></Shell.TitleView>
 <Grid>
  <ScrollView x:Name="PageScroll" HorizontalScrollBarVisibility="Never">
   <VerticalStackLayout Padding="16" Spacing="14" MaximumWidthRequest="1180" HorizontalOptions="Fill">
    <VerticalStackLayout Spacing="4">
     <Label Text="Vinculação de Temas" Style="{StaticResource BtPageTitleStyle}" SemanticProperties.HeadingLevel="Level1" FontAutoScalingEnabled="False"/>
     <Label Text="Escolha o tema, selecione o trecho bíblico e vincule os versículos." Style="{StaticResource BtSubtitleStyle}"/>
    </VerticalStackLayout>

    <Border Style="{StaticResource BtCardStyle}" Padding="14">
     <VerticalStackLayout Spacing="10">
      <Label Text="1. Tema" Style="{StaticResource BtSectionTitleStyle}"/>
      <Label Text="O tema define onde os versículos ficarão agrupados." Style="{StaticResource BtSubtitleStyle}"/>
      <Border Style="{StaticResource BtStatusWarningStyle}">
       <Border.Triggers>
        <DataTrigger TargetType="Border" Binding="{Binding HasThemes}" Value="True"><Setter Property="IsVisible" Value="False"/></DataTrigger>
       </Border.Triggers>
       <VerticalStackLayout Spacing="8">
        <Label Text="Nenhum tema cadastrado. Cadastre um tema antes de vincular versículos."/>
        <Button Text="＋ Criar tema" Style="{StaticResource BtPrimaryButtonStyle}" Command="{Binding CreateThemeCommand}"/>
       </VerticalStackLayout>
      </Border>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
       <VerticalStackLayout Spacing="6">
        <Label Text="Tema *" Style="{StaticResource FieldLabel}"/>
        <Border Style="{StaticResource BtSelectionFieldStyle}" IsEnabled="{Binding HasThemes}">
         <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenThemeSheetCommand}"/></Border.GestureRecognizers>
         <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <BoxView Color="{Binding SelectedThemeColor}" WidthRequest="12" HeightRequest="12" CornerRadius="6" VerticalOptions="Center"/>
          <Label Grid.Column="1" Text="{Binding SelectedThemeText}" VerticalOptions="Center"/>
          <Label Grid.Column="2" Text="⌄" TextColor="{StaticResource BtPrimary}" FontSize="20"/>
         </Grid>
        </Border>
       </VerticalStackLayout>
       <Button Grid.Column="1" Text="Novo tema" Style="{StaticResource BtSecondaryButtonStyle}" Command="{Binding CreateThemeCommand}" VerticalOptions="End" IsVisible="{Binding HasThemes}" FontSize="13" FontAutoScalingEnabled="False"/>
      </Grid>
     </VerticalStackLayout>
    </Border>

    <Grid x:Name="ResponsiveGrid" ColumnDefinitions="*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="14" HorizontalOptions="Fill">
     <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
       <VisualState x:Name="Narrow"/>
       <VisualState x:Name="Wide">
        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="800"/></VisualState.StateTriggers>
        <VisualState.Setters>
         <Setter TargetName="ResponsiveGrid" Property="Grid.ColumnDefinitions" Value="1.15*,0.85*"/>
         <Setter TargetName="DesktopRightPane" Property="Grid.Row" Value="0"/>
         <Setter TargetName="DesktopRightPane" Property="Grid.Column" Value="1"/>
        </VisualState.Setters>
       </VisualState>
      </VisualStateGroup>
     </VisualStateManager.VisualStateGroups>

     <VerticalStackLayout x:Name="BiblePane" Grid.Row="0" Spacing="12" HorizontalOptions="Fill">
      <Border Style="{StaticResource BtCardStyle}" Padding="14">
       <VerticalStackLayout Spacing="10">
        <Label Text="2. Trecho bíblico" Style="{StaticResource BtSectionTitleStyle}"/>
        <Label Text="Pesquise uma palavra ou navegue por versão, livro e capítulo." Style="{StaticResource BtSubtitleStyle}"/>
        <Label Text="Pesquisar na Bíblia" Style="{StaticResource FieldLabel}"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
         <Border Style="{StaticResource BtSearchContainerStyle}">
          <Entry Placeholder="Digite uma palavra ou frase..." Text="{Binding BibleSearchText}" ReturnType="Search" ReturnCommand="{Binding SearchBibleCommand}" ClearButtonVisibility="WhileEditing"/>
         </Border>
         <Button Grid.Column="1" Text="Buscar" Style="{StaticResource BtPrimaryButtonStyle}" Command="{Binding SearchBibleCommand}" MinimumWidthRequest="88"/>
        </Grid>
        <Label Text="A pesquisa usa somente a versão selecionada e mostra os resultados na lista abaixo." Style="{StaticResource BtSubtitleStyle}"/>
        <BoxView HeightRequest="1" Color="{StaticResource BtBorder}"/>
        <Label Text="Versão" Style="{StaticResource FieldLabel}"/>
        <CollectionView x:Name="VersionsList" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" SelectionMode="Single" HeightRequest="46">
         <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/></CollectionView.ItemsLayout>
         <CollectionView.ItemTemplate><DataTemplate><components:BtSelectableChip Text="{Binding Code}"/></DataTemplate></CollectionView.ItemTemplate>
        </CollectionView>
        <Label Text="Livro" Style="{StaticResource FieldLabel}"/>
        <CollectionView x:Name="BooksList" ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook}" SelectionMode="Single" HeightRequest="46">
         <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/></CollectionView.ItemsLayout>
         <CollectionView.ItemTemplate><DataTemplate><components:BtSelectableChip Text="{Binding Name}"/></DataTemplate></CollectionView.ItemTemplate>
        </CollectionView>
        <Label Text="Capítulo" Style="{StaticResource FieldLabel}"/>
        <CollectionView x:Name="ChaptersList" ItemsSource="{Binding Chapters}" SelectedItem="{Binding SelectedChapter}" SelectionMode="Single" HeightRequest="46">
         <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/></CollectionView.ItemsLayout>
         <CollectionView.ItemTemplate><DataTemplate><components:BtSelectableChip Text="{Binding .}" MinimumChipWidth="44"/></DataTemplate></CollectionView.ItemTemplate>
        </CollectionView>
       </VerticalStackLayout>
      </Border>

      <Label Text="Versículos" Style="{StaticResource BtSectionTitleStyle}"/>
      <Label Text="Toque em um versículo para selecionar. Um segundo toque distinto forma o intervalo." Style="{StaticResource BtSubtitleStyle}"/>
      <Grid HeightRequest="430" HorizontalOptions="Fill">
       <CollectionView ItemsSource="{Binding Verses}" SelectionMode="None">
        <CollectionView.ItemTemplate>
         <DataTemplate>
          <Border Margin="0,4" Padding="14,12" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light={StaticResource BtSurface},Dark={StaticResource BtDarkSurface}}" Stroke="{AppThemeBinding Light={StaticResource BtBorder},Dark={StaticResource BtDarkBorder}}">
           <Border.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True"><Setter Property="BackgroundColor" Value="{StaticResource BtSelectedBackground}"/><Setter Property="Stroke" Value="{StaticResource BtSelectedBorder}"/></DataTrigger>
            <DataTrigger TargetType="Border" Binding="{Binding IsAlreadyAdded}" Value="True"><Setter Property="BackgroundColor" Value="{StaticResource BtSelectedBackground}"/><Setter Property="Opacity" Value="0.72"/></DataTrigger>
           </Border.Triggers>
           <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.ToggleVerseCommand}" CommandParameter="{Binding .}"/>
           </Border.GestureRecognizers>
           <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4" ColumnSpacing="8">
            <Label Text="{Binding DisplayReference}" FontAttributes="Bold" TextColor="{StaticResource BtPrimary}"/>
            <Border Grid.Column="1" Style="{StaticResource BtBadgeStyle}" IsVisible="{Binding IsAlreadyAdded}"><Label Text="✓ Já adicionada" FontSize="11" TextColor="{StaticResource BtPrimary}"/></Border>
            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Text}" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light={StaticResource BtTextPrimary},Dark={StaticResource BtDarkTextPrimary}}"/>
           </Grid>
          </Border>
         </DataTemplate>
        </CollectionView.ItemTemplate>
       </CollectionView>
       <ActivityIndicator IsRunning="{Binding IsBibleBusy}" IsVisible="{Binding IsBibleBusy}" ZIndex="2"/>
      </Grid>
     </VerticalStackLayout>

     <VerticalStackLayout x:Name="DesktopRightPane" Grid.Row="1" Spacing="12" HorizontalOptions="Fill">
      <Border Style="{StaticResource BtCardStyle}" Padding="14">
       <VerticalStackLayout Spacing="10">
        <Label Text="3. Vincular" Style="{StaticResource BtSectionTitleStyle}"/>
        <VerticalStackLayout Spacing="2">
         <Label Text="Selecionado" Style="{StaticResource FieldLabel}"/>
         <Label Text="{Binding FormattedReference}" TextColor="{StaticResource BtPrimary}" FontAttributes="Bold" FontSize="17" LineBreakMode="WordWrap"/>
         <Label Text="{Binding SelectedVersion.Code}" Style="{StaticResource BtSubtitleStyle}"/>
         <Label Text="{Binding SelectionHint}" Style="{StaticResource BtSubtitleStyle}"/>
        </VerticalStackLayout>
        <Label Text="Comentário da referência" Style="{StaticResource FieldLabel}"/>
        <Border Style="{StaticResource BtEditorContainerStyle}">
         <Editor Text="{Binding Comment}" Placeholder="Escreva um comentário sobre esta referência..." MinimumHeightRequest="88" AutoSize="TextChanges"/>
        </Border>
        <Label Text="{Binding AddRequirementText}" Style="{StaticResource BtSubtitleStyle}"/>
        <Button Text="Vincular versículo ao tema" Style="{StaticResource BtPrimaryButtonStyle}" MinimumHeightRequest="52" Command="{Binding AddCommand}">
         <Button.Triggers>
          <DataTrigger TargetType="Button" Binding="{Binding IsEditing}" Value="True"><Setter Property="IsVisible" Value="False"/></DataTrigger>
         </Button.Triggers>
        </Button>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsEditing}">
         <Button Text="Salvar alterações" Style="{StaticResource BtPrimaryButtonStyle}" Command="{Binding SaveCommand}"/>
         <Button Grid.Column="1" Text="Cancelar" Style="{StaticResource BtSecondaryButtonStyle}" Command="{Binding CancelEditCommand}"/>
        </Grid>
        <Border Style="{StaticResource BtStatusInfoStyle}"><Label Text="{Binding Status}" Style="{StaticResource BtSubtitleStyle}" LineBreakMode="WordWrap"/></Border>
       </VerticalStackLayout>
      </Border>

      <Label Text="{Binding ReferencesTitle}" Style="{StaticResource BtSectionTitleStyle}" LineBreakMode="WordWrap"/>
      <CollectionView ItemsSource="{Binding Items}" SelectionMode="None" HeightRequest="360" HorizontalOptions="Fill">
       <CollectionView.ItemTemplate>
        <DataTemplate>
         <Border Style="{StaticResource BtCardStyle}" Margin="0,5" Padding="14,12" HorizontalOptions="Fill">
          <VerticalStackLayout Spacing="6">
           <Label Text="{Binding DisplayReference}" FontAttributes="Bold" FontSize="17" TextColor="{StaticResource BtPrimary}"/>
           <Label Text="{Binding Themes}" TextColor="{StaticResource BtPrimary}" LineBreakMode="WordWrap"/>
           <Label Text="Comentário" Style="{StaticResource FieldLabel}"/>
           <Label Text="{Binding Comment}" LineBreakMode="WordWrap"/>
          </VerticalStackLayout>
         </Border>
        </DataTemplate>
       </CollectionView.ItemTemplate>
       <CollectionView.EmptyView>
        <Border Style="{StaticResource BtCardStyle}" Padding="14">
         <VerticalStackLayout Spacing="4">
          <Label Text="Nenhum versículo vinculado." FontAttributes="Bold"/>
          <Label Text="Selecione o tema e um trecho bíblico para começar." Style="{StaticResource BtSubtitleStyle}"/>
         </VerticalStackLayout>
        </Border>
       </CollectionView.EmptyView>
      </CollectionView>
     </VerticalStackLayout>
    </Grid>
   </VerticalStackLayout>
  </ScrollView>
  <components:AppSelectionSheet IsOpen="{Binding IsThemeSheetOpen}" Title="Selecionar tema" ItemsSource="{Binding ThemeOptions}" ItemTappedCommand="{Binding SelectThemeCommand}" CloseCommand="{Binding CloseThemeSheetCommand}" SearchCommand="{Binding SearchThemeCommand}" SearchText="{Binding ThemeSearchText}" SearchPlaceholder="Pesquisar tema..." IsSearchVisible="True"/>
  <Grid BackgroundColor="{StaticResource BtOverlaySoft}" IsVisible="{Binding IsBusy}" ZIndex="2000">
   <Border Style="{StaticResource BtCardStyle}" HorizontalOptions="Center" VerticalOptions="Center">
    <HorizontalStackLayout Spacing="12">
     <ActivityIndicator IsRunning="True"/>
     <Label Text="Salvando..." VerticalOptions="Center"/>
    </HorizontalStackLayout>
   </Border>
  </Grid>
 </Grid>
</ContentPage>
