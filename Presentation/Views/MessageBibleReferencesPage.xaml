<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Biblia.Presentation.Components"
             x:Class="Biblia.Presentation.Views.MessageBibleReferencesPage"
             x:Name="Root"
             Title="Mensagens e Pregações"
             Style="{StaticResource BtPageStyle}"
             Shell.BackgroundColor="{StaticResource BtHeader}"
             Shell.TitleColor="White">
 <Grid>
  <ScrollView x:Name="PageScroll">
   <Grid x:Name="ResponsiveGrid" Padding="16" ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="18" MaximumWidthRequest="1180" HorizontalOptions="Center">
    <VisualStateManager.VisualStateGroups><VisualStateGroup><VisualState x:Name="Narrow"/><VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="800"/></VisualState.StateTriggers><VisualState.Setters><Setter TargetName="ResponsiveGrid" Property="Grid.ColumnDefinitions" Value="1.15*,0.85*"/><Setter TargetName="LinkPane" Property="Grid.Row" Value="0"/><Setter TargetName="LinkPane" Property="Grid.Column" Value="1"/><Setter TargetName="ReferencesPane" Property="Grid.Row" Value="1"/><Setter TargetName="ReferencesPane" Property="Grid.ColumnSpan" Value="2"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>

    <VerticalStackLayout x:Name="BiblePane" Grid.Row="0" Spacing="16">
     <Border Style="{StaticResource BtCardStyle}" Padding="14">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4"><VerticalStackLayout><Label Text="Mensagem ou Pregação" Style="{StaticResource FieldLabel}"/><Label Text="{Binding MessageTitle}" FontSize="19" FontAttributes="Bold"/><Label Text="{Binding MessageType}" Style="{StaticResource BtSubtitleStyle}"/></VerticalStackLayout><Button Grid.Column="1" Text="＋ Nova / editar" Style="{StaticResource BtCompactButtonStyle}" Command="{Binding SelectMessageCommand}" FontAutoScalingEnabled="False"/></Grid>
     </Border>
     <CollectionView x:Name="MessagesList" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}" SelectionMode="Single" HeightRequest="46" IsVisible="{Binding HasMessage}"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><components:BtSelectableChip Text="{Binding Title}"/></DataTemplate></CollectionView.ItemTemplate></CollectionView>

     <Border Style="{StaticResource BtCardStyle}"><VerticalStackLayout Spacing="10">
      <Label Text="Referência bíblica" Style="{StaticResource BtSectionTitleStyle}"/>
      <Label Text="Versão" Style="{StaticResource FieldLabel}"/><CollectionView x:Name="VersionsList" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" SelectionMode="Single" HeightRequest="46"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><components:BtSelectableChip Text="{Binding Code}"/></DataTemplate></CollectionView.ItemTemplate></CollectionView>
      <Label Text="Livro" Style="{StaticResource FieldLabel}"/><CollectionView x:Name="BooksList" ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook}" SelectionMode="Single" HeightRequest="46"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><components:BtSelectableChip Text="{Binding Name}"/></DataTemplate></CollectionView.ItemTemplate></CollectionView>
      <Label Text="Capítulo" Style="{StaticResource FieldLabel}"/><CollectionView x:Name="ChaptersList" ItemsSource="{Binding Chapters}" SelectedItem="{Binding SelectedChapter}" SelectionMode="Single" HeightRequest="46"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><components:BtSelectableChip Text="{Binding .}" MinimumChipWidth="44"/></DataTemplate></CollectionView.ItemTemplate></CollectionView>
     </VerticalStackLayout></Border>

     <Label Text="Versículos" Style="{StaticResource BtSectionTitleStyle}"/>
     <Grid HeightRequest="430"><CollectionView ItemsSource="{Binding Verses}" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate><Border Margin="0,4" Padding="14,12" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light={StaticResource BtSurface},Dark={StaticResource BtDarkSurface}}" Stroke="{AppThemeBinding Light={StaticResource BtBorder},Dark={StaticResource BtDarkBorder}}"><Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True"><Setter Property="BackgroundColor" Value="{StaticResource BtSelectedBackground}"/><Setter Property="Stroke" Value="{StaticResource BtSelectedBorder}"/></DataTrigger></Border.Triggers><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.ToggleVerseCommand}" CommandParameter="{Binding .}"/></Border.GestureRecognizers><Grid ColumnDefinitions="38,*" ColumnSpacing="8"><Label Text="{Binding Number}" FontAttributes="Bold" TextColor="{StaticResource BtPrimary}"/><Label Grid.Column="1" Text="{Binding Text}" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light={StaticResource BtTextPrimary},Dark={StaticResource BtDarkTextPrimary}}"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView><ActivityIndicator IsRunning="{Binding IsBibleBusy}" IsVisible="{Binding IsBibleBusy}" ZIndex="2"/></Grid>
    </VerticalStackLayout>

    <VerticalStackLayout x:Name="LinkPane" Grid.Row="1" Spacing="16">
     <Border Style="{StaticResource BtCardStyle}"><VerticalStackLayout Spacing="4"><Label Text="Selecionado" Style="{StaticResource FieldLabel}"/><Label Text="{Binding FormattedReference}" TextColor="{StaticResource BtPrimary}" FontAttributes="Bold" FontSize="17"/><Label Text="{Binding SelectedVersion.Code}" Style="{StaticResource BtSubtitleStyle}"/><Label Text="{Binding SelectionHint}" Style="{StaticResource BtSubtitleStyle}"/></VerticalStackLayout></Border>

     <VerticalStackLayout Spacing="8"><Label Text="Tema" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource BtSelectionFieldStyle}"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenThemeSheetCommand}"/></Border.GestureRecognizers><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><BoxView Color="{Binding SelectedThemeColor}" WidthRequest="12" HeightRequest="12" CornerRadius="6" VerticalOptions="Center"/><Label Grid.Column="1" Text="{Binding SelectedThemeText}" VerticalOptions="Center"/><Label Grid.Column="2" Text="⌄" TextColor="{StaticResource BtPrimary}" FontSize="20"/></Grid></Border></VerticalStackLayout>
     <VerticalStackLayout Spacing="8"><Label Text="Seção opcional (modo avançado)" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource BtSelectionFieldStyle}" IsEnabled="{Binding HasTopics}"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenTopicSheetCommand}"/></Border.GestureRecognizers><Grid ColumnDefinitions="*,Auto"><Label Text="{Binding SelectedTopicText}" VerticalOptions="Center"/><Label Grid.Column="1" Text="⌄" TextColor="{StaticResource BtPrimary}" FontSize="20"/></Grid></Border></VerticalStackLayout>
     <VerticalStackLayout Spacing="8"><Label Text="Comentário da referência" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource BtEditorContainerStyle}"><Editor Text="{Binding Comment}" Placeholder="Escreva um comentário sobre esta referência..." MinimumHeightRequest="100" AutoSize="TextChanges"/></Border></VerticalStackLayout>
     <VerticalStackLayout Spacing="8"><Label Text="Nota somente nesta pregação (opcional)" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource BtEditorContainerStyle}"><Editor Text="{Binding Observation}" Placeholder="Use apenas quando precisar de uma nota contextual..." MinimumHeightRequest="80" AutoSize="TextChanges"/></Border></VerticalStackLayout>
     <Label Text="{Binding AddRequirementText}" Style="{StaticResource BtSubtitleStyle}"/>
     <Button Text="Adicionar referência à mensagem" Style="{StaticResource BtPrimaryButtonStyle}" MinimumHeightRequest="52" Command="{Binding AddCommand}"><Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsEditing}" Value="True"><Setter Property="IsVisible" Value="False"/></DataTrigger></Button.Triggers></Button>
     <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsEditing}"><Button Text="Salvar alterações" Style="{StaticResource BtPrimaryButtonStyle}" Command="{Binding SaveCommand}"/><Button Grid.Column="1" Text="Cancelar" Style="{StaticResource BtSecondaryButtonStyle}" Command="{Binding CancelEditCommand}"/></Grid>
     <Border Style="{StaticResource BtStatusInfoStyle}"><Label Text="{Binding Status}" Style="{StaticResource BtSubtitleStyle}"/></Border>
    </VerticalStackLayout>

    <VerticalStackLayout x:Name="ReferencesPane" Grid.Row="2" Spacing="10">
     <Label Text="{Binding ReferencesTitle}" Style="{StaticResource BtSectionTitleStyle}"/>
     <CollectionView ItemsSource="{Binding Items}" SelectionMode="None" HeightRequest="420"><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource BtCardStyle}" Margin="0,5"><VerticalStackLayout Spacing="8"><Label Text="{Binding DisplayReference}" FontAttributes="Bold" FontSize="17" TextColor="{StaticResource BtPrimary}"/><Label Text="{Binding Themes}" TextColor="{StaticResource BtPrimary}"/><Label Text="Comentário" Style="{StaticResource FieldLabel}"/><Label Text="{Binding Comment}"/><Label Text="Tópico" Style="{StaticResource FieldLabel}"/><Label Text="{Binding Topic}"/><Label Text="Observação" Style="{StaticResource FieldLabel}"/><Label Text="{Binding Observation}"/><Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8"><Button Text="Editar" Style="{StaticResource BtCompactButtonStyle}" Command="{Binding Source={x:Reference Root},Path=BindingContext.EditCommand}" CommandParameter="{Binding .}"/><Button Grid.Column="1" Text="Remover" Style="{StaticResource BtDangerButtonStyle}" Command="{Binding Source={x:Reference Root},Path=BindingContext.DeleteCommand}" CommandParameter="{Binding .}"/></Grid></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate><CollectionView.EmptyView><Border Style="{StaticResource BtCardStyle}"><VerticalStackLayout><Label Text="Nenhuma referência vinculada." FontAttributes="Bold"/><Label Text="Selecione um trecho acima para começar." Style="{StaticResource BtSubtitleStyle}"/></VerticalStackLayout></Border></CollectionView.EmptyView></CollectionView>
    </VerticalStackLayout>
   </Grid>
  </ScrollView>
  <components:AppSelectionSheet IsOpen="{Binding IsThemeSheetOpen}" Title="Selecionar tema" ItemsSource="{Binding ThemeOptions}" ItemTappedCommand="{Binding SelectThemeCommand}" CloseCommand="{Binding CloseThemeSheetCommand}" SearchCommand="{Binding SearchThemeCommand}" SearchText="{Binding ThemeSearchText}" SearchPlaceholder="Pesquisar tema..." IsSearchVisible="True"/>
  <components:AppSelectionSheet IsOpen="{Binding IsTopicSheetOpen}" Title="Selecionar tópico" ItemsSource="{Binding TopicOptions}" ItemTappedCommand="{Binding SelectTopicCommand}" CloseCommand="{Binding CloseTopicSheetCommand}"/>
  <Grid BackgroundColor="{StaticResource BtOverlaySoft}" IsVisible="{Binding IsBusy}" ZIndex="2000"><Border Style="{StaticResource BtCardStyle}" HorizontalOptions="Center" VerticalOptions="Center"><HorizontalStackLayout Spacing="12"><ActivityIndicator IsRunning="True"/><Label Text="Salvando..." VerticalOptions="Center"/></HorizontalStackLayout></Border></Grid>
 </Grid>
</ContentPage>
