<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Biblia.Presentation.Components"
             x:Class="Biblia.Presentation.Views.MessageBibleReferencesPage"
             x:Name="Root"
             Title="Vinculação de Temas"
             Style="{StaticResource BtPageStyle}"
             Shell.BackgroundColor="{StaticResource BtHeader}"
             Shell.TitleColor="White">
 <Shell.TitleView><components:PageHeaderView Title="Vinculação de Temas" FallbackRoute="//Home"/></Shell.TitleView>
 <Grid>
  <ScrollView x:Name="PageScroll">
   <Grid x:Name="ResponsiveGrid" Padding="16" ColumnDefinitions="*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="18" MaximumWidthRequest="1180" HorizontalOptions="Center">
    <VisualStateManager.VisualStateGroups><VisualStateGroup><VisualState x:Name="Narrow"/><VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="800"/></VisualState.StateTriggers><VisualState.Setters><Setter TargetName="ResponsiveGrid" Property="Grid.ColumnDefinitions" Value="1.15*,0.85*"/><Setter TargetName="DesktopRightPane" Property="Grid.Row" Value="0"/><Setter TargetName="DesktopRightPane" Property="Grid.Column" Value="1"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>

    <VerticalStackLayout x:Name="BiblePane" Grid.Row="0" Spacing="16">
     <Border Style="{StaticResource BtCardStyle}" Padding="12">
      <VerticalStackLayout Spacing="6">
       <Label Text="Pesquisar na Bíblia" Style="{StaticResource FieldLabel}"/>
       <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <Border Style="{StaticResource BtSearchContainerStyle}"><Entry Placeholder="Digite uma palavra ou frase..." Text="{Binding BibleSearchText}" ReturnType="Search" ReturnCommand="{Binding SearchBibleCommand}" ClearButtonVisibility="WhileEditing"/></Border>
        <Button Grid.Column="1" Text="Buscar" Style="{StaticResource BtPrimaryButtonStyle}" Command="{Binding SearchBibleCommand}" MinimumWidthRequest="88"/>
       </Grid>
       <Label Text="A pesquisa usa somente a versão bíblica selecionada e mostra os resultados na lista de versículos abaixo." Style="{StaticResource BtSubtitleStyle}"/>
      </VerticalStackLayout>
     </Border>
     <Border Style="{StaticResource BtCardStyle}"><VerticalStackLayout Spacing="10">
      <Label Text="Referência bíblica" Style="{StaticResource BtSectionTitleStyle}"/>
      <Label Text="Versão" Style="{StaticResource FieldLabel}"/><CollectionView x:Name="VersionsList" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" SelectionMode="Single" HeightRequest="46"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><components:BtSelectableChip Text="{Binding Code}"/></DataTemplate></CollectionView.ItemTemplate></CollectionView>
      <Label Text="Livro" Style="{StaticResource FieldLabel}"/><CollectionView x:Name="BooksList" ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook}" SelectionMode="Single" HeightRequest="46"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><components:BtSelectableChip Text="{Binding Name}"/></DataTemplate></CollectionView.ItemTemplate></CollectionView>
      <Label Text="Capítulo" Style="{StaticResource FieldLabel}"/><CollectionView x:Name="ChaptersList" ItemsSource="{Binding Chapters}" SelectedItem="{Binding SelectedChapter}" SelectionMode="Single" HeightRequest="46"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><components:BtSelectableChip Text="{Binding .}" MinimumChipWidth="44"/></DataTemplate></CollectionView.ItemTemplate></CollectionView>
     </VerticalStackLayout></Border>

     <Label Text="Versículos" Style="{StaticResource BtSectionTitleStyle}"/>
     <Grid HeightRequest="430"><CollectionView ItemsSource="{Binding Verses}" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate><Border Margin="0,4" Padding="14,12" StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light={StaticResource BtSurface},Dark={StaticResource BtDarkSurface}}" Stroke="{AppThemeBinding Light={StaticResource BtBorder},Dark={StaticResource BtDarkBorder}}"><Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True"><Setter Property="BackgroundColor" Value="{StaticResource BtSelectedBackground}"/><Setter Property="Stroke" Value="{StaticResource BtSelectedBorder}"/></DataTrigger><DataTrigger TargetType="Border" Binding="{Binding IsAlreadyAdded}" Value="True"><Setter Property="BackgroundColor" Value="{StaticResource BtSelectedBackground}"/><Setter Property="Opacity" Value="0.72"/></DataTrigger></Border.Triggers><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.ToggleVerseCommand}" CommandParameter="{Binding .}"/></Border.GestureRecognizers><Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4" ColumnSpacing="8"><Label Text="{Binding DisplayReference}" FontAttributes="Bold" TextColor="{StaticResource BtPrimary}"/><Border Grid.Column="1" Style="{StaticResource BtBadgeStyle}" IsVisible="{Binding IsAlreadyAdded}"><Label Text="✓ Já adicionada" FontSize="11" TextColor="{StaticResource BtPrimary}"/></Border><Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Text}" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light={StaticResource BtTextPrimary},Dark={StaticResource BtDarkTextPrimary}}"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView><ActivityIndicator IsRunning="{Binding IsBibleBusy}" IsVisible="{Binding IsBibleBusy}" ZIndex="2"/></Grid>
    </VerticalStackLayout>

    <VerticalStackLayout x:Name="DesktopRightPane" Grid.Row="1" Spacing="22">
    <VerticalStackLayout x:Name="LinkPane" Spacing="16">
     <Border Style="{StaticResource BtCardStyle}"><VerticalStackLayout Spacing="4"><Label Text="Selecionado" Style="{StaticResource FieldLabel}"/><Label Text="{Binding FormattedReference}" TextColor="{StaticResource BtPrimary}" FontAttributes="Bold" FontSize="17"/><Label Text="{Binding SelectedVersion.Code}" Style="{StaticResource BtSubtitleStyle}"/><Label Text="{Binding SelectionHint}" Style="{StaticResource BtSubtitleStyle}"/></VerticalStackLayout></Border>

     <Border Style="{StaticResource BtStatusWarningStyle}"><Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding HasThemes}" Value="True"><Setter Property="IsVisible" Value="False"/></DataTrigger></Border.Triggers><VerticalStackLayout Spacing="8"><Label Text="Nenhum tema cadastrado. Cadastre um tema antes de vincular versículos."/><Button Text="＋ Criar tema" Style="{StaticResource BtPrimaryButtonStyle}" Command="{Binding CreateThemeCommand}"/></VerticalStackLayout></Border>
     <VerticalStackLayout Spacing="8"><Label Text="Tema *" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource BtSelectionFieldStyle}" IsEnabled="{Binding HasThemes}"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenThemeSheetCommand}"/></Border.GestureRecognizers><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><BoxView Color="{Binding SelectedThemeColor}" WidthRequest="12" HeightRequest="12" CornerRadius="6" VerticalOptions="Center"/><Label Grid.Column="1" Text="{Binding SelectedThemeText}" VerticalOptions="Center"/><Label Grid.Column="2" Text="⌄" TextColor="{StaticResource BtPrimary}" FontSize="20"/></Grid></Border></VerticalStackLayout>
     <VerticalStackLayout Spacing="8"><Label Text="Comentário da referência" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource BtEditorContainerStyle}"><Editor Text="{Binding Comment}" Placeholder="Escreva um comentário sobre esta referência..." MinimumHeightRequest="100" AutoSize="TextChanges"/></Border></VerticalStackLayout>
     <Label Text="{Binding AddRequirementText}" Style="{StaticResource BtSubtitleStyle}"/>
     <Button Text="Vincular versículo ao tema" Style="{StaticResource BtPrimaryButtonStyle}" MinimumHeightRequest="52" Command="{Binding AddCommand}"><Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsEditing}" Value="True"><Setter Property="IsVisible" Value="False"/></DataTrigger></Button.Triggers></Button>
     <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsEditing}"><Button Text="Salvar alterações" Style="{StaticResource BtPrimaryButtonStyle}" Command="{Binding SaveCommand}"/><Button Grid.Column="1" Text="Cancelar" Style="{StaticResource BtSecondaryButtonStyle}" Command="{Binding CancelEditCommand}"/></Grid>
     <Border Style="{StaticResource BtStatusInfoStyle}"><Label Text="{Binding Status}" Style="{StaticResource BtSubtitleStyle}"/></Border>
    </VerticalStackLayout>

    <VerticalStackLayout x:Name="ReferencesPane" Spacing="10">
     <Label Text="{Binding ReferencesTitle}" Style="{StaticResource BtSectionTitleStyle}"/>
     <CollectionView ItemsSource="{Binding Items}" SelectionMode="None" HeightRequest="420" HorizontalOptions="Fill"><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource BtCardStyle}" Margin="0,5" HorizontalOptions="Fill"><VerticalStackLayout Spacing="8"><Label Text="{Binding DisplayReference}" FontAttributes="Bold" FontSize="17" TextColor="{StaticResource BtPrimary}"/><Label Text="{Binding Themes}" TextColor="{StaticResource BtPrimary}"/><Label Text="Comentário" Style="{StaticResource FieldLabel}"/><Label Text="{Binding Comment}" LineBreakMode="WordWrap"/></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate><CollectionView.EmptyView><Border Style="{StaticResource BtCardStyle}"><VerticalStackLayout><Label Text="Nenhum versículo vinculado." FontAttributes="Bold"/><Label Text="Selecione um trecho acima para começar." Style="{StaticResource BtSubtitleStyle}"/></VerticalStackLayout></Border></CollectionView.EmptyView></CollectionView>
    </VerticalStackLayout>
    </VerticalStackLayout>
   </Grid>
  </ScrollView>
  <components:AppSelectionSheet IsOpen="{Binding IsThemeSheetOpen}" Title="Selecionar tema" ItemsSource="{Binding ThemeOptions}" ItemTappedCommand="{Binding SelectThemeCommand}" CloseCommand="{Binding CloseThemeSheetCommand}" SearchCommand="{Binding SearchThemeCommand}" SearchText="{Binding ThemeSearchText}" SearchPlaceholder="Pesquisar tema..." IsSearchVisible="True"/>
  <components:AppSelectionSheet IsOpen="{Binding IsTopicSheetOpen}" Title="Selecionar tópico" ItemsSource="{Binding TopicOptions}" ItemTappedCommand="{Binding SelectTopicCommand}" CloseCommand="{Binding CloseTopicSheetCommand}"/>
  <Grid BackgroundColor="{StaticResource BtOverlaySoft}" IsVisible="{Binding IsBusy}" ZIndex="2000"><Border Style="{StaticResource BtCardStyle}" HorizontalOptions="Center" VerticalOptions="Center"><HorizontalStackLayout Spacing="12"><ActivityIndicator IsRunning="True"/><Label Text="Salvando..." VerticalOptions="Center"/></HorizontalStackLayout></Border></Grid>
 </Grid>
</ContentPage>
