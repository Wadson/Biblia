<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Biblia.Presentation.Views.BibleComparisonPage" Title="Comparar versões">
    <Grid Padding="16" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="10">
        <Label Text="Comparar versões" Style="{StaticResource PageTitle}" SemanticProperties.HeadingLevel="Level1"/>
        <Label Grid.Row="1" Text="{Binding ReferenceText}" Style="{StaticResource BibleReferenceText}" FontSize="18"/>
        <CollectionView Grid.Row="2" ItemsSource="{Binding Versions}" HeightRequest="52" SelectionMode="None"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><HorizontalStackLayout><CheckBox IsChecked="{Binding IsSelected}"/><Label Text="{Binding Code}" VerticalTextAlignment="Center"/><Label Text="Atual" IsVisible="{Binding IsSource}" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalTextAlignment="Center"/></HorizontalStackLayout></DataTemplate></CollectionView.ItemTemplate></CollectionView>
        <Button Grid.Row="3" Text="Comparar versões selecionadas" Command="{Binding CompareCommand}"/>
        <CollectionView Grid.Row="4" ItemsSource="{Binding Items}" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource AppCard}" Margin="0,4"><VerticalStackLayout Spacing="5"><HorizontalStackLayout Spacing="8"><Label Text="{Binding VersionCode}" Style="{StaticResource BibleReferenceText}"/><Label Text="Atual" IsVisible="{Binding IsSource}" FontAttributes="Bold" TextColor="{StaticResource Primary}"/></HorizontalStackLayout><Label Text="{Binding DisplayName}"/><Label Text="{Binding StatusText}" Style="{StaticResource BodySecondary}"/><Label Text="{Binding Message}" Style="{StaticResource BodySecondary}"/><VerticalStackLayout BindableLayout.ItemsSource="{Binding Verses}"><BindableLayout.ItemTemplate><DataTemplate><Grid ColumnDefinitions="32,*" ColumnSpacing="6"><Label Text="{Binding Verse}" FontAttributes="Bold" TextColor="{StaticResource Primary}"/><Label Grid.Column="1" Text="{Binding Text}" LineBreakMode="WordWrap"/></Grid></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate><CollectionView.EmptyView><Label Text="Nenhuma comparação carregada." Style="{StaticResource BodySecondary}"/></CollectionView.EmptyView></CollectionView>
        <Grid Grid.Row="5"><ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/><Label Text="{Binding Status}" HorizontalOptions="End" VerticalTextAlignment="Center"/></Grid>
    </Grid>
</ContentPage>
