<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Biblia.Presentation.Views.BibleSearchPage" Title="Pesquisar na Bíblia"><Grid Padding="16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10"><Label Text="Pesquisar na Bíblia" Style="{StaticResource PageTitle}" SemanticProperties.HeadingLevel="Level1"/><FlexLayout Grid.Row="1" Direction="Row" Wrap="Wrap"><Entry FlexLayout.Basis="100%" Placeholder="Digite uma palavra ou expressão" Text="{Binding Text}" ReturnType="Search"/><Button FlexLayout.Basis="48%" Text="Pesquisar" Command="{Binding SearchCommand}"/><Button FlexLayout.Basis="48%" Text="Limpar" Command="{Binding ClearCommand}"/></FlexLayout><Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8"><CollectionView ItemsSource="{Binding Versions}" HeightRequest="52"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><HorizontalStackLayout><CheckBox IsChecked="{Binding IsSelected}"/><Label Text="{Binding Code}" VerticalTextAlignment="Center"/></HorizontalStackLayout></DataTemplate></CollectionView.ItemTemplate></CollectionView><CollectionView Grid.Row="1" ItemsSource="{Binding Results}"><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource AppCard}" Margin="0,4"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><Label Text="{Binding Verse}" Style="{StaticResource BibleReferenceText}"/><VerticalStackLayout Grid.Column="1"><Label Text="{Binding VersionCode}" FontAttributes="Bold"/><Label Text="{Binding BookName}"/><Label Text="{Binding Text}" LineBreakMode="WordWrap"/></VerticalStackLayout></Grid></Border></DataTemplate></CollectionView.ItemTemplate><CollectionView.EmptyView><Label Text="{Binding Status}"/></CollectionView.EmptyView></CollectionView></Grid><VerticalStackLayout Grid.Row="3"><ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}"/><Button Text="Carregar mais" Command="{Binding LoadMoreCommand}" IsVisible="{Binding HasMore}"/><Label Text="{Binding Status}"/></VerticalStackLayout></Grid></ContentPage>
