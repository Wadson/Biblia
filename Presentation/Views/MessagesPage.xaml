<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:components="clr-namespace:Biblia.Presentation.Components" x:Class="Biblia.Presentation.Views.MessagesPage" Title="Mensagens" Style="{StaticResource BtPageStyle}" Shell.BackgroundColor="{StaticResource BtHeader}" Shell.TitleColor="White">
 <Shell.BackButtonBehavior><BackButtonBehavior IsVisible="False" IsEnabled="True"/></Shell.BackButtonBehavior>
 <Shell.TitleView><components:PageHeaderView Title="Mensagens"/></Shell.TitleView>
 <Grid>
  <ScrollView><VerticalStackLayout Padding="16" Spacing="16" MaximumWidthRequest="1160" HorizontalOptions="Center">
   <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><VerticalStackLayout><Label Text="Mensagens" Style="{StaticResource BtPageTitleStyle}"/><Label Text="Planeje mensagens, estudos e pregações em um só lugar." Style="{StaticResource BtSubtitleStyle}"/></VerticalStackLayout><Button Grid.Column="1" Text="＋ Nova mensagem" Style="{StaticResource BtSecondaryButtonStyle}" Command="{Binding NewCommand}"/></Grid>
   <Border Style="{StaticResource BtCardStyle}" Padding="12"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Border Style="{StaticResource BtSearchContainerStyle}"><Entry Placeholder="Pesquisar mensagens..." Text="{Binding SearchText}" ReturnType="Search" ReturnCommand="{Binding SearchCommand}"/></Border><Button Grid.Column="1" Text="Buscar" Style="{StaticResource BtPrimaryButtonStyle}" Command="{Binding SearchCommand}"/></Grid></Border>
   <VerticalStackLayout Spacing="8"><Label Text="Filtrar por tipo" Style="{StaticResource FieldLabel}"/><CollectionView ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" SelectionMode="Single" HeightRequest="48"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><components:BtSelectableChip Text="{Binding Label}"/></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout>

   <Grid x:Name="MessagesGrid" ColumnDefinitions="*" RowDefinitions="Auto,Auto" RowSpacing="16"><VisualStateManager.VisualStateGroups><VisualStateGroup><VisualState x:Name="Narrow"/><VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="820"/></VisualState.StateTriggers><VisualState.Setters><Setter TargetName="MessagesGrid" Property="Grid.ColumnDefinitions" Value="0.9*,1.1*"/><Setter TargetName="EditorPane" Property="Grid.Row" Value="0"/><Setter TargetName="EditorPane" Property="Grid.Column" Value="1"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
    <VerticalStackLayout Grid.Row="0" Spacing="10"><Label Text="Mensagens salvas" Style="{StaticResource BtSectionTitleStyle}"/><CollectionView ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" SelectionMode="Single" HeightRequest="330"><CollectionView.ItemTemplate><DataTemplate><Grid Margin="0,4"><VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="SelectionStates"><VisualState x:Name="Normal"><VisualState.Setters><Setter TargetName="MessageCard" Property="Border.BackgroundColor" Value="{StaticResource BtSurface}"/><Setter TargetName="MessageCard" Property="Border.Stroke" Value="{StaticResource BtBorder}"/><Setter TargetName="MessageTitle" Property="Label.TextColor" Value="{StaticResource BtTextPrimary}"/></VisualState.Setters></VisualState><VisualState x:Name="Selected"><VisualState.Setters><Setter TargetName="MessageCard" Property="Border.BackgroundColor" Value="{StaticResource BtSelectedBackground}"/><Setter TargetName="MessageCard" Property="Border.Stroke" Value="{StaticResource BtSelectedBorder}"/><Setter TargetName="MessageTitle" Property="Label.TextColor" Value="{StaticResource BtPrimary}"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups><Border x:Name="MessageCard" Style="{StaticResource BtCardStyle}" Padding="14"><Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6"><Label x:Name="MessageTitle" Text="{Binding Title}" FontAttributes="Bold" FontSize="17"/><Border Grid.Column="1" Style="{StaticResource BtBadgeStyle}"><Label Text="{Binding Type}" FontSize="12" TextColor="{StaticResource BtPrimary}"/></Border><Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}" MaxLines="2" Style="{StaticResource BtSubtitleStyle}"/><Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding UpdatedAt,StringFormat='Atualizada em {0:dd/MM/yyyy}'}" Style="{StaticResource Caption}"/></Grid></Border></Grid></DataTemplate></CollectionView.ItemTemplate><CollectionView.EmptyView><Border Style="{StaticResource BtCardStyle}" Margin="0,8"><VerticalStackLayout><Label Text="Nenhuma mensagem encontrada." FontAttributes="Bold" FontSize="17"/><Label Text="Use “Nova mensagem”, preencha o título e salve." Style="{StaticResource BtSubtitleStyle}"/></VerticalStackLayout></Border></CollectionView.EmptyView></CollectionView></VerticalStackLayout>

    <VerticalStackLayout x:Name="EditorPane" Grid.Row="1" Spacing="10"><Border Style="{StaticResource BtCardStyle}"><VerticalStackLayout Spacing="10"><Label Text="{Binding EditorTitle}" Style="{StaticResource BtSectionTitleStyle}"/><Label Text="Título da mensagem" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource BtEntryContainerStyle}"><Entry Placeholder="Informe um título" Text="{Binding Title}"/></Border><Label Text="Tipo" Style="{StaticResource FieldLabel}"/><CollectionView ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedTypeOption}" SelectionMode="Single" HeightRequest="48"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><components:BtSelectableChip Text="{Binding Label}"/></DataTemplate></CollectionView.ItemTemplate></CollectionView><Label Text="Versão bíblica preferida" Style="{StaticResource FieldLabel}"/><CollectionView ItemsSource="{Binding Versions}" SelectedItem="{Binding PreferredVersion}" SelectionMode="Single" HeightRequest="48"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><components:BtSelectableChip Text="{Binding Code}"/></DataTemplate></CollectionView.ItemTemplate><CollectionView.EmptyView><Label Text="Nenhuma versão instalada." Style="{StaticResource BtSubtitleStyle}"/></CollectionView.EmptyView></CollectionView><Label Text="Descrição" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource BtEditorContainerStyle}"><Editor Placeholder="Resumo da mensagem" Text="{Binding Description}" MinimumHeightRequest="80" AutoSize="TextChanges"/></Border><Label Text="Introdução" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource BtEditorContainerStyle}"><Editor Placeholder="Abertura e contexto" Text="{Binding Introduction}" MinimumHeightRequest="100" AutoSize="TextChanges"/></Border><Label Text="Conclusão" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource BtEditorContainerStyle}"><Editor Placeholder="Aplicação e encerramento" Text="{Binding Conclusion}" MinimumHeightRequest="100" AutoSize="TextChanges"/></Border><Label Text="{Binding RequirementText}" Style="{StaticResource BtSubtitleStyle}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="Salvar mensagem" Style="{StaticResource BtPrimaryButtonStyle}" Command="{Binding SaveCommand}"/><Button Grid.Column="1" Text="Excluir" Style="{StaticResource BtDangerButtonStyle}" Command="{Binding DeleteCommand}"/></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="Tópicos" Style="{StaticResource BtSecondaryButtonStyle}" Command="{Binding TopicsCommand}"/><Button Grid.Column="1" Text="Referências" Style="{StaticResource BtSecondaryButtonStyle}" Command="{Binding ReferencesCommand}"/></Grid></VerticalStackLayout></Border><Border Style="{StaticResource BtStatusInfoStyle}"><Label Text="{Binding Status}" Style="{StaticResource BtSubtitleStyle}"/></Border></VerticalStackLayout>
   </Grid>
  </VerticalStackLayout></ScrollView>
  <Grid BackgroundColor="{StaticResource BtOverlaySoft}" IsVisible="{Binding IsBusy}" ZIndex="100"><Border Style="{StaticResource BtCardStyle}" HorizontalOptions="Center" VerticalOptions="Center"><HorizontalStackLayout Spacing="10"><ActivityIndicator IsRunning="True"/><Label Text="Carregando mensagens..." VerticalOptions="Center"/></HorizontalStackLayout></Border></Grid>
 </Grid>
</ContentPage>
