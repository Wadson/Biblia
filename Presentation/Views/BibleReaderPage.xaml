<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Biblia.Presentation.Views.BibleReaderPage" Title="Ler Bíblia">
 <Grid RowDefinitions="Auto,*,Auto" Padding="12" RowSpacing="10" MaximumWidthRequest="980" HorizontalOptions="Center">
  <Border Style="{StaticResource AppCard}" Padding="14">
   <VerticalStackLayout Spacing="9">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="5"><VerticalStackLayout Spacing="0"><Label Text="{Binding ReaderTitle}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level1"/><Label Text="Leitura e estudo" Style="{StaticResource Caption}"/></VerticalStackLayout><Button Grid.Column="1" Text="A−" Command="{Binding DecreaseFontCommand}" Padding="10,4"/><Button Grid.Column="2" Text="A" Command="{Binding ResetFontCommand}" Padding="10,4"/><Button Grid.Column="3" Text="A+" Command="{Binding IncreaseFontCommand}" Padding="10,4"/></Grid>
    <Label Text="Versão" Style="{StaticResource FieldLabel}"/><CollectionView x:Name="VersionsCollectionView" HeightRequest="42" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion,Mode=TwoWay}" SelectionMode="Single" SelectionChanged="OnVersionChanged"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="6"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource AppCard}" Padding="11,4"><Border.VisualStateManager.VisualStateGroups><VisualStateGroupList><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="Selected"><VisualState.Setters><Setter Property="BackgroundColor" Value="{StaticResource Primary}"/><Setter TargetName="VersionText" Property="Label.TextColor" Value="White"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateGroupList></Border.VisualStateManager.VisualStateGroups><Label x:Name="VersionText" Text="{Binding Code}" FontAttributes="Bold"/></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Label Text="Livro" Style="{StaticResource FieldLabel}"/><CollectionView x:Name="BooksCollectionView" HeightRequest="42" ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook,Mode=TwoWay}" SelectionMode="Single" SelectionChanged="OnBookChanged"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="6"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource AppCard}" Padding="11,4"><Border.VisualStateManager.VisualStateGroups><VisualStateGroupList><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="Selected"><VisualState.Setters><Setter Property="BackgroundColor" Value="{StaticResource Primary}"/><Setter TargetName="BookText" Property="Label.TextColor" Value="White"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateGroupList></Border.VisualStateManager.VisualStateGroups><Label x:Name="BookText" Text="{Binding Name}" FontAttributes="Bold"/></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6"><VerticalStackLayout Spacing="3"><Label Text="Capítulo" Style="{StaticResource FieldLabel}"/><CollectionView x:Name="ChaptersCollectionView" HeightRequest="42" ItemsSource="{Binding Chapters}" SelectedItem="{Binding SelectedChapter,Mode=TwoWay}" SelectionMode="Single" SelectionChanged="OnChapterChanged"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="6"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource AppCard}" Padding="12,4"><Border.VisualStateManager.VisualStateGroups><VisualStateGroupList><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="Selected"><VisualState.Setters><Setter Property="BackgroundColor" Value="{StaticResource Primary}"/><Setter TargetName="ChapterText" Property="Label.TextColor" Value="White"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateGroupList></Border.VisualStateManager.VisualStateGroups><Label x:Name="ChapterText" Text="{Binding}" FontAttributes="Bold"/></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout><Button Grid.Column="1" Text="‹" Command="{Binding PreviousChapterCommand}" VerticalOptions="End" SemanticProperties.Description="Capítulo anterior"/><Button Grid.Column="2" Text="›" Command="{Binding NextChapterCommand}" VerticalOptions="End" SemanticProperties.Description="Próximo capítulo"/></Grid>
   </VerticalStackLayout>
  </Border>
  <CollectionView x:Name="VersesCollectionView" Grid.Row="1" ItemsSource="{Binding VerseItems}" SelectionMode="None">
   <CollectionView.ItemTemplate><DataTemplate><Border Padding="12,10" Margin="0,2" BackgroundColor="Transparent" StrokeThickness="0"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},Path=BindingContext.SelectVerseCommand}" CommandParameter="{Binding}"/></Border.GestureRecognizers><Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True"><Setter Property="BackgroundColor" Value="{StaticResource BtSelectedBackground}"/><Setter Property="Stroke" Value="{StaticResource BtSelectedBorder}"/><Setter Property="StrokeThickness" Value="1"/></DataTrigger></Border.Triggers><Grid ColumnDefinitions="34,*" ColumnSpacing="8"><Label Text="{Binding Number}" FontAttributes="Bold" TextColor="{StaticResource BtPrimary}"/><Label Grid.Column="1" Text="{Binding Text}" Style="{StaticResource BibleBody}" FontSize="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},Path=BindingContext.VerseFontSize}" LineBreakMode="WordWrap"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate>
   <CollectionView.EmptyView><Label Text="Nenhum versículo disponível nesta seleção." Style="{StaticResource BodySecondary}" HorizontalTextAlignment="Center" Margin="20"/></CollectionView.EmptyView>
  </CollectionView>
  <Border Grid.Row="2" IsVisible="{Binding HasSelectionVisible}" Style="{StaticResource AppCard}" Padding="10" Stroke="{StaticResource Accent}"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><VerticalStackLayout Spacing="1"><Label Text="{Binding SelectedReferenceText}" Style="{StaticResource BibleReferenceText}"/><Label Text="Ações para o trecho selecionado" Style="{StaticResource Caption}"/></VerticalStackLayout><Button Grid.Column="1" Text="Copiar" Command="{Binding CopyCommand}"/><Button Grid.Column="2" Text="Comparar" Command="{Binding CompareCommand}"/></Grid></Border>
 </Grid>
</ContentPage>
