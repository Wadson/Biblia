<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Biblia.Presentation.Views.BibleReaderPage" Title="Ler Bíblia" BackgroundColor="{StaticResource BtSurface}" Shell.BackgroundColor="{StaticResource BtHeader}" Shell.TitleColor="White">
 <Grid RowDefinitions="Auto,*,Auto">
  <Border x:Name="ReaderControls" HeightRequest="56" BackgroundColor="{StaticResource BtSurface}" Stroke="{StaticResource BtBorder}" StrokeThickness="0,0,0,1" Padding="12,5" ZIndex="10"><Grid ColumnDefinitions="*,62,76,48" ColumnSpacing="5" MaximumWidthRequest="900" HorizontalOptions="Center">
   <Button Text="{Binding SelectedBook.Name}" Style="{StaticResource BtSecondaryButtonStyle}" Padding="8,0" FontSize="15" LineBreakMode="TailTruncation" Clicked="OnOpenBookSelector" SemanticProperties.Hint="Selecionar livro da Bíblia"/>
   <Button Grid.Column="1" Text="{Binding SelectedChapter}" Style="{StaticResource BtSecondaryButtonStyle}" Padding="3,0" Clicked="OnOpenChapterSelector" SemanticProperties.Hint="Selecionar capítulo"/>
   <Button Grid.Column="2" Text="{Binding SelectedVersion.Code}" Style="{StaticResource BtSecondaryButtonStyle}" Padding="3,0" TextColor="{StaticResource BtPrimary}" Clicked="OnOpenVersionSelector" SemanticProperties.Hint="Selecionar versão da Bíblia"/>
   <Button Grid.Column="3" Text="⋮" Style="{StaticResource BtIconButtonStyle}" Padding="0" Clicked="OnMoreClicked" FontSize="24" SemanticProperties.Hint="Opções de leitura"/>
  </Grid></Border>
  <Grid Grid.Row="1" BackgroundColor="{StaticResource BtSurface}">
   <CollectionView x:Name="VersesCollectionView" ItemsSource="{Binding VerseItems}" SelectionMode="None" Scrolled="OnVersesScrolled" MaximumWidthRequest="900" HorizontalOptions="Center">
    <CollectionView.Header><VerticalStackLayout Padding="22,22,22,12" Spacing="9"><Label Text="{Binding ReaderTitle}" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource BtTextPrimary}" SemanticProperties.HeadingLevel="Level1"/><BoxView WidthRequest="54" HeightRequest="2" Color="{StaticResource BtGold}" HorizontalOptions="Center"/></VerticalStackLayout></CollectionView.Header>
    <CollectionView.ItemTemplate><DataTemplate><Border Padding="22,9" BackgroundColor="Transparent" Stroke="Transparent" StrokeThickness="1"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},Path=BindingContext.SelectVerseCommand}" CommandParameter="{Binding}"/></Border.GestureRecognizers><Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True"><Setter Property="BackgroundColor" Value="{StaticResource BtSelectedBackground}"/><Setter Property="Stroke" Value="{StaticResource BtSelectedBorder}"/></DataTrigger></Border.Triggers><Grid ColumnDefinitions="30,*" ColumnSpacing="8"><Label Text="{Binding Number}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource BtPrimary}" Padding="0,4,0,0"/><Label Grid.Column="1" Text="{Binding Text}" Style="{StaticResource BibleBody}" FontSize="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},Path=BindingContext.VerseFontSize}" LineBreakMode="WordWrap"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate>
    <CollectionView.Footer><Grid Padding="22,18,22,28" ColumnDefinitions="*,*" ColumnSpacing="10"><Button Text="‹ Capítulo anterior" Style="{StaticResource BtSecondaryButtonStyle}" Command="{Binding PreviousChapterCommand}" FontSize="13"/><Button Grid.Column="1" Text="Próximo capítulo ›" Style="{StaticResource BtSecondaryButtonStyle}" Command="{Binding NextChapterCommand}" FontSize="13"/></Grid></CollectionView.Footer>
    <CollectionView.EmptyView><VerticalStackLayout Margin="24" Spacing="10" VerticalOptions="Center"><Label Text="Este capítulo não está disponível nesta versão." Style="{StaticResource BtSectionTitleStyle}" HorizontalTextAlignment="Center"/><Label Text="Selecione outra versão, livro ou capítulo na barra superior." Style="{StaticResource BtSubtitleStyle}" HorizontalTextAlignment="Center"/></VerticalStackLayout></CollectionView.EmptyView>
   </CollectionView><ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" HorizontalOptions="End" VerticalOptions="Start" Margin="0,10,16,0" Color="{StaticResource BtPrimary}"/>
  </Grid>
  <Border Grid.Row="2" IsVisible="{Binding HasSelectionVisible}" BackgroundColor="{StaticResource BtSelectedBackground}" Stroke="{StaticResource BtSelectedBorder}" Padding="12,7" ZIndex="20"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5" MaximumWidthRequest="900" HorizontalOptions="Center"><Label Text="{Binding SelectedReferenceText}" TextColor="{StaticResource BtPrimary}" FontAttributes="Bold" VerticalTextAlignment="Center" LineBreakMode="TailTruncation"/><Button Grid.Column="1" Text="Copiar" Style="{StaticResource BtCompactButtonStyle}" Command="{Binding CopyCommand}"/><Button Grid.Column="2" Text="Comparar" Style="{StaticResource BtCompactButtonStyle}" Command="{Binding CompareCommand}"/></Grid></Border>
  <Grid x:Name="ReadingOptionsOverlay" Grid.RowSpan="3" IsVisible="False" BackgroundColor="{StaticResource BtOverlay}" ZIndex="100"><Border Style="{StaticResource BtCardStyle}" Margin="22" Padding="20" VerticalOptions="Center" MaximumWidthRequest="480"><VerticalStackLayout Spacing="14"><Grid ColumnDefinitions="*,Auto"><Label Text="Opções de leitura" Style="{StaticResource BtSectionTitleStyle}"/><Button Grid.Column="1" Text="✕" Style="{StaticResource BtIconButtonStyle}" Clicked="OnCloseMoreClicked"/></Grid><Label Text="Tamanho do texto" Style="{StaticResource FieldLabel}"/><Grid ColumnDefinitions="*,*,*" ColumnSpacing="8"><Button Text="A−" Style="{StaticResource BtSecondaryButtonStyle}" Command="{Binding DecreaseFontCommand}"/><Button Grid.Column="1" Text="A" Style="{StaticResource BtSecondaryButtonStyle}" Command="{Binding ResetFontCommand}"/><Button Grid.Column="2" Text="A+" Style="{StaticResource BtSecondaryButtonStyle}" Command="{Binding IncreaseFontCommand}"/></Grid><Button Text="Comparar versões" Style="{StaticResource BtSecondaryButtonStyle}" Command="{Binding CompareCommand}" IsVisible="{Binding HasSelectionVisible}"/><Button Text="Fechar" Style="{StaticResource BtPrimaryButtonStyle}" Clicked="OnCloseMoreClicked"/></VerticalStackLayout></Border></Grid>
  <Grid x:Name="BookSelectorOverlay" Grid.RowSpan="3" IsVisible="False" BackgroundColor="{StaticResource BtOverlay}" ZIndex="110"><Border Style="{StaticResource BtCardStyle}" Margin="18,80,18,28" Padding="16" MaximumWidthRequest="560"><Grid RowDefinitions="Auto,*" RowSpacing="12"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="2"><Label Text="Livro" Style="{StaticResource BtSectionTitleStyle}"/><Label Text="Selecione um livro da Bíblia" Style="{StaticResource BtSubtitleStyle}"/></VerticalStackLayout><Button Grid.Column="1" Text="✕" Style="{StaticResource BtIconButtonStyle}" Clicked="OnCloseSelectors"/></Grid><CollectionView Grid.Row="1" ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook,Mode=TwoWay}" SelectionMode="Single" SelectionChanged="OnBookSelected"><CollectionView.ItemTemplate><DataTemplate><Border x:Name="BookOption" Padding="14,11" Margin="0,2" BackgroundColor="{StaticResource BtSurface}" Stroke="{StaticResource BtBorder}"><VisualStateManager.VisualStateGroups><VisualStateGroup Name="CommonStates"><VisualState Name="Normal"/><VisualState Name="Selected"><VisualState.Setters><Setter TargetName="BookOption" Property="BackgroundColor" Value="{StaticResource BtSelectedBackground}"/><Setter TargetName="BookOption" Property="Stroke" Value="{StaticResource BtSelectedBorder}"/><Setter TargetName="BookName" Property="Label.TextColor" Value="{StaticResource BtPrimary}"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups><Label x:Name="BookName" Text="{Binding Name}" TextColor="{StaticResource BtTextPrimary}" FontSize="16"/></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></Grid></Border></Grid>
  <Grid x:Name="ChapterSelectorOverlay" Grid.RowSpan="3" IsVisible="False" BackgroundColor="{StaticResource BtOverlay}" ZIndex="110"><Border Style="{StaticResource BtCardStyle}" Margin="18" Padding="16" VerticalOptions="Center" MaximumWidthRequest="560" MaximumHeightRequest="620"><Grid RowDefinitions="Auto,*" RowSpacing="12"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="2"><Label Text="Capítulo" Style="{StaticResource BtSectionTitleStyle}"/><Label Text="Selecione o capítulo" Style="{StaticResource BtSubtitleStyle}"/></VerticalStackLayout><Button Grid.Column="1" Text="✕" Style="{StaticResource BtIconButtonStyle}" Clicked="OnCloseSelectors"/></Grid><CollectionView Grid.Row="1" ItemsSource="{Binding Chapters}" SelectedItem="{Binding SelectedChapter,Mode=TwoWay}" SelectionMode="Single" SelectionChanged="OnChapterSelected"><CollectionView.ItemsLayout><GridItemsLayout Orientation="Vertical" Span="5" HorizontalItemSpacing="7" VerticalItemSpacing="7"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><Border x:Name="ChapterOption" Padding="5,12" BackgroundColor="{StaticResource BtSurface}" Stroke="{StaticResource BtBorder}"><VisualStateManager.VisualStateGroups><VisualStateGroup Name="CommonStates"><VisualState Name="Normal"/><VisualState Name="Selected"><VisualState.Setters><Setter TargetName="ChapterOption" Property="BackgroundColor" Value="{StaticResource BtSelectedBackground}"/><Setter TargetName="ChapterOption" Property="Stroke" Value="{StaticResource BtSelectedBorder}"/><Setter TargetName="ChapterNumber" Property="Label.TextColor" Value="{StaticResource BtPrimary}"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups><Label x:Name="ChapterNumber" Text="{Binding .}" HorizontalTextAlignment="Center" FontAttributes="Bold" TextColor="{StaticResource BtTextPrimary}"/></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></Grid></Border></Grid>
  <Grid x:Name="VersionSelectorOverlay" Grid.RowSpan="3" IsVisible="False" BackgroundColor="{StaticResource BtOverlay}" ZIndex="110"><Border Style="{StaticResource BtCardStyle}" Margin="18" Padding="16" VerticalOptions="Center" MaximumWidthRequest="560" MaximumHeightRequest="620"><Grid RowDefinitions="Auto,*" RowSpacing="12"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="2"><Label Text="Versão da Bíblia" Style="{StaticResource BtSectionTitleStyle}"/><Label Text="Selecione a tradução para leitura" Style="{StaticResource BtSubtitleStyle}"/></VerticalStackLayout><Button Grid.Column="1" Text="✕" Style="{StaticResource BtIconButtonStyle}" Clicked="OnCloseSelectors"/></Grid><CollectionView Grid.Row="1" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion,Mode=TwoWay}" SelectionMode="Single" SelectionChanged="OnVersionSelected"><CollectionView.ItemTemplate><DataTemplate><Border x:Name="VersionOption" Padding="14,11" Margin="0,2" BackgroundColor="{StaticResource BtSurface}" Stroke="{StaticResource BtBorder}"><VisualStateManager.VisualStateGroups><VisualStateGroup Name="CommonStates"><VisualState Name="Normal"/><VisualState Name="Selected"><VisualState.Setters><Setter TargetName="VersionOption" Property="BackgroundColor" Value="{StaticResource BtSelectedBackground}"/><Setter TargetName="VersionOption" Property="Stroke" Value="{StaticResource BtSelectedBorder}"/><Setter TargetName="VersionCode" Property="Label.TextColor" Value="{StaticResource BtPrimary}"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups><Grid ColumnDefinitions="72,*" ColumnSpacing="10"><Label x:Name="VersionCode" Text="{Binding Code}" FontAttributes="Bold" TextColor="{StaticResource BtPrimary}"/><Label Grid.Column="1" Text="{Binding Name}" TextColor="{StaticResource BtTextPrimary}" LineBreakMode="TailTruncation"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></Grid></Border></Grid>
 </Grid>
</ContentPage>
