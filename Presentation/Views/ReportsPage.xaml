<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:components="clr-namespace:Biblia.Presentation.Components" x:Class="Biblia.Presentation.Views.ReportsPage" Title="Relatórios" BackgroundColor="{StaticResource BtAppBackground}" Shell.BackgroundColor="{StaticResource BtHeader}" Shell.TitleColor="White">
 <Shell.TitleView><components:PageHeaderView Title="Relatórios" FallbackRoute="//Home"/></Shell.TitleView>
 <Grid>
  <ScrollView><VerticalStackLayout Padding="16" Spacing="14" MaximumWidthRequest="1180" HorizontalOptions="Center">
   <Grid><VerticalStackLayout Spacing="4"><Label Text="Gerador de pregações" Style="{StaticResource PageTitle}" SemanticProperties.HeadingLevel="Level1"/><Label Text="Organize mensagens e referências temáticas em um documento editorial pronto para apresentar, salvar ou compartilhar." Style="{StaticResource BodySecondary}"/></VerticalStackLayout></Grid>
   <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Start">
    <VerticalStackLayout FlexLayout.Basis="350" FlexLayout.Grow="1" Spacing="12" Margin="0,0,12,12">
     <Border Style="{StaticResource BtCardStyle}" Padding="14"><VerticalStackLayout Spacing="10">
      <Label Text="1. O que gerar" Style="{StaticResource SectionTitle}"/>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="Pregação" Command="{Binding SelectSermonCommand}" Style="{StaticResource BtSecondaryButtonStyle}"><Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsSermon}" Value="True"><Setter Property="BackgroundColor" Value="{StaticResource BtSelectedBackground}"/><Setter Property="BorderColor" Value="{StaticResource BtSelectedBorder}"/><Setter Property="TextColor" Value="{StaticResource BtPrimary}"/></DataTrigger></Button.Triggers></Button><Button Grid.Column="1" Text="Mensagem" Command="{Binding SelectMessageCommand}" Style="{StaticResource BtSecondaryButtonStyle}"><Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsMessageDocument}" Value="True"><Setter Property="BackgroundColor" Value="{StaticResource BtSelectedBackground}"/><Setter Property="BorderColor" Value="{StaticResource BtSelectedBorder}"/><Setter Property="TextColor" Value="{StaticResource BtPrimary}"/></DataTrigger></Button.Triggers></Button></Grid>
      <Label Text="Origem" Style="{StaticResource FieldLabel}"/>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="Pregação cadastrada" Command="{Binding SelectRegisteredCommand}" Style="{StaticResource BtSecondaryButtonStyle}" FontSize="12"><Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsMessageMode}" Value="True"><Setter Property="BackgroundColor" Value="{StaticResource BtSelectedBackground}"/><Setter Property="BorderColor" Value="{StaticResource BtSelectedBorder}"/><Setter Property="TextColor" Value="{StaticResource BtPrimary}"/></DataTrigger></Button.Triggers></Button><Button Grid.Column="1" Text="Tema(s)" Command="{Binding SelectThemesCommand}" Style="{StaticResource BtSecondaryButtonStyle}"><Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding ThemeMode}" Value="True"><Setter Property="BackgroundColor" Value="{StaticResource BtSelectedBackground}"/><Setter Property="BorderColor" Value="{StaticResource BtSelectedBorder}"/><Setter Property="TextColor" Value="{StaticResource BtPrimary}"/></DataTrigger></Button.Triggers></Button></Grid>
      <VerticalStackLayout IsVisible="{Binding IsMessageMode}" Spacing="6"><Label Text="Mensagem cadastrada" Style="{StaticResource FieldLabel}"/><Picker ItemsSource="{Binding Messages}" ItemDisplayBinding="{Binding Title}" SelectedItem="{Binding SelectedMessage}" Title="Selecione uma mensagem"/></VerticalStackLayout>
     </VerticalStackLayout></Border>
     <Border Style="{StaticResource BtCardStyle}" Padding="14" IsVisible="{Binding ThemeMode}"><VerticalStackLayout Spacing="9"><Label Text="2. Temas" Style="{StaticResource SectionTitle}"/><Entry Placeholder="Pesquisar temas..." Text="{Binding ThemeSearch}"/><Label Text="{Binding SelectedThemesSummary}" Style="{StaticResource BtSubtitleStyle}"/>
      <CollectionView ItemsSource="{Binding Themes}" HeightRequest="220" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate><Border x:Name="ThemeOption" Padding="10,8" Margin="0,2" Stroke="{StaticResource BtBorder}" BackgroundColor="{StaticResource BtSurface}"><Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True"><Setter Property="BackgroundColor" Value="{StaticResource BtSelectedBackground}"/><Setter Property="Stroke" Value="{StaticResource BtSelectedBorder}"/></DataTrigger></Border.Triggers><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},Path=BindingContext.ToggleThemeCommand}" CommandParameter="{Binding}"/></Border.GestureRecognizers><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9"><BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="{Binding Theme.ColorHex}" VerticalOptions="Center"/><Label Grid.Column="1" Text="{Binding Theme.Name}" TextColor="{StaticResource BtTextPrimary}" VerticalTextAlignment="Center"/><Label Grid.Column="2" Text="✓" TextColor="{StaticResource BtPrimary}" FontAttributes="Bold" IsVisible="{Binding IsSelected}"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
     </VerticalStackLayout></Border>
     <Border Style="{StaticResource BtCardStyle}" Padding="14"><VerticalStackLayout Spacing="8"><Label Text="3. Personalização" Style="{StaticResource SectionTitle}"/><Label Text="Título do documento" Style="{StaticResource FieldLabel}"/><Entry Text="{Binding Title}" Placeholder="Título"/><Label Text="Subtítulo opcional" Style="{StaticResource FieldLabel}"/><Entry Text="{Binding Subtitle}" Placeholder="Subtítulo"/><Label Text="Introdução opcional" Style="{StaticResource FieldLabel}"/><Editor Text="{Binding Introduction}" Placeholder="Contexto e abertura..." AutoSize="TextChanges" MinimumHeightRequest="80"/><Label Text="Conclusão opcional" Style="{StaticResource FieldLabel}"/><Editor Text="{Binding Conclusion}" Placeholder="Aplicação e encerramento..." AutoSize="TextChanges" MinimumHeightRequest="80"/>
      <VerticalStackLayout IsVisible="{Binding ThemeMode}" Spacing="5"><Label Text="Versão bíblica" Style="{StaticResource FieldLabel}"/><Picker ItemsSource="{Binding BibleVersions}" ItemDisplayBinding="{Binding DisplayName}" SelectedItem="{Binding SelectedVersion}" Title="Selecione a versão"/></VerticalStackLayout>
      <Button Text="Gerar prévia" Style="{StaticResource BtPrimaryButtonStyle}" Command="{Binding BuildCommand}"/>
     </VerticalStackLayout></Border>
    </VerticalStackLayout>
    <VerticalStackLayout FlexLayout.Basis="480" FlexLayout.Grow="2" Spacing="10">
     <Grid ColumnDefinitions="*,Auto"><Label Text="4. Prévia e exportação" Style="{StaticResource SectionTitle}"/><Button Grid.Column="1" Text="Gerar PDF" Style="{StaticResource BtPrimaryButtonStyle}" Command="{Binding PdfCommand}" Padding="18,8"/></Grid>
     <Border Style="{StaticResource BtCardStyle}" Padding="0" MinimumHeightRequest="500"><VerticalStackLayout>
      <Grid BackgroundColor="{StaticResource BtHeader}" Padding="18,12" ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="BÍBLIATEMA" TextColor="White" FontAttributes="Bold"/><Label Text="Premium Edition" TextColor="{StaticResource BtGold}" FontSize="11"/></VerticalStackLayout><Label Grid.Column="1" Text="{Binding Report.DocumentType}" TextColor="{StaticResource BtGold}" FontAttributes="Bold" VerticalTextAlignment="Center"/></Grid>
      <VerticalStackLayout Padding="18" Spacing="9" IsVisible="{Binding HasPreview}"><Label Text="{Binding Report.Title}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource BtHeader}"/><Label Text="{Binding Report.Subtitle}" Style="{StaticResource BodySecondary}"/><Label Text="{Binding Report.VersionLabel}" TextColor="{StaticResource BtPrimary}" FontAttributes="Bold"/><Border BackgroundColor="{StaticResource BtGoldSoft}" Stroke="{StaticResource BtGold}" Padding="12" IsVisible="{Binding Report.HasIntroduction}"><VerticalStackLayout><Label Text="INTRODUÇÃO" FontAttributes="Bold" TextColor="{StaticResource BtHeader}"/><Label Text="{Binding Report.Introduction}"/></VerticalStackLayout></Border>
       <VerticalStackLayout BindableLayout.ItemsSource="{Binding Report.Sections}" Spacing="14"><BindableLayout.ItemTemplate><DataTemplate><VerticalStackLayout Spacing="6"><Grid ColumnDefinitions="5,*"><BoxView Color="{Binding Theme.ColorHex}"/><Label Grid.Column="1" Text="{Binding Title}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource BtHeader}" Margin="9,0"/></Grid><Label Text="{Binding Content}" Style="{StaticResource BodySecondary}"/>
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding References}" Spacing="9"><BindableLayout.ItemTemplate><DataTemplate><Border Stroke="{StaticResource BtBorder}" BackgroundColor="{StaticResource BtSurface}" Padding="12"><VerticalStackLayout Spacing="5"><Label Text="{Binding FormattedReference}" TextColor="{StaticResource BtPrimary}" FontAttributes="Bold"/><Label Text="{Binding PreviewPassageText}" TextColor="{StaticResource BtTextPrimary}" LineBreakMode="WordWrap"/><Label Text="{Binding VersionCode,StringFormat='Versão: {0}'}" Style="{StaticResource Caption}"/><Border BackgroundColor="{StaticResource BtAppBackground}" Stroke="{StaticResource BtBorder}" Padding="9" IsVisible="{Binding HasComment}"><VerticalStackLayout><Label Text="Comentário" FontAttributes="Bold" FontSize="12"/><Label Text="{Binding Comment}" FontSize="13"/></VerticalStackLayout></Border></VerticalStackLayout></Border></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
       </VerticalStackLayout></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
       <Border BackgroundColor="{StaticResource BtGoldSoft}" Stroke="{StaticResource BtGold}" Padding="12" IsVisible="{Binding Report.HasConclusion}"><VerticalStackLayout><Label Text="CONCLUSÃO" FontAttributes="Bold" TextColor="{StaticResource BtHeader}"/><Label Text="{Binding Report.Conclusion}"/></VerticalStackLayout></Border>
      </VerticalStackLayout>
      <VerticalStackLayout Padding="24" VerticalOptions="Center" IsVisible="{Binding ShowEmptyPreview}"><Label Text="Configure a origem e toque em “Gerar prévia”." Style="{StaticResource BtSubtitleStyle}" HorizontalTextAlignment="Center"/></VerticalStackLayout>
     </VerticalStackLayout></Border>
    </VerticalStackLayout>
   </FlexLayout>
   <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="{StaticResource BtPrimary}"/><Label Text="{Binding Status}" Style="{StaticResource BodySecondary}"/>
  </VerticalStackLayout></ScrollView>
  <Grid IsVisible="{Binding ExportVisible}" BackgroundColor="{StaticResource BtOverlay}" ZIndex="100"><Border Style="{StaticResource BtCardStyle}" Padding="20" Margin="22" MaximumWidthRequest="480" VerticalOptions="Center"><VerticalStackLayout Spacing="13"><Label Text="PDF pronto" Style="{StaticResource PageTitle}"/><Label Text="PDF gerado com sucesso. O que deseja fazer?" Style="{StaticResource BodySecondary}"/><Button Text="Salvar em..." Style="{StaticResource BtPrimaryButtonStyle}" Command="{Binding SaveCommand}"/><Button Text="Compartilhar" Style="{StaticResource BtSecondaryButtonStyle}" Command="{Binding ShareCommand}"/><Button Text="Cancelar" Style="{StaticResource BtSecondaryButtonStyle}" Clicked="OnCancelExport"/></VerticalStackLayout></Border></Grid>
 </Grid>
</ContentPage>
