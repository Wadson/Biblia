<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Biblia.Presentation.Views.ReportsPage" Title="Relatórios">
    <ScrollView><VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="Relatórios" Style="{StaticResource PageTitle}" SemanticProperties.HeadingLevel="Level1"/>
        <Label Text="Consulte o panorama do conteúdo e prepare uma mensagem em formato de leitura." Style="{StaticResource BodySecondary}"/>
        <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Start">
            <VerticalStackLayout FlexLayout.Basis="300" FlexLayout.Grow="1" Spacing="8" Margin="0,0,12,12">
                <Border Style="{StaticResource AppCard}"><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto"><Label Text="Mensagens" Style="{StaticResource FieldLabel}"/><Label Grid.Column="1" Text="{Binding Overview.Messages}" FontAttributes="Bold"/><Label Grid.Row="1" Text="Pregações / Estudos" Style="{StaticResource FieldLabel}"/><Label Grid.Row="1" Grid.Column="1" Text="{Binding Overview.Sermons}" FontAttributes="Bold"/><Label Grid.Row="2" Text="Devocionais" Style="{StaticResource FieldLabel}"/><Label Grid.Row="2" Grid.Column="1" Text="{Binding Overview.Devotionals}" FontAttributes="Bold"/><Label Grid.Row="3" Text="Referências / Temas" Style="{StaticResource FieldLabel}"/><Label Grid.Row="3" Grid.Column="1" Text="{Binding Overview.References}" FontAttributes="Bold"/></Grid></Border>
                <Label Text="Relatório de mensagem" Style="{StaticResource SectionTitle}"/>
                <Label Text="Selecione uma mensagem" Style="{StaticResource FieldLabel}"/><CollectionView HeightRequest="52" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="6"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource AppCard}" Padding="10,5"><Label Text="{Binding Title}"/></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
                <Button Text="Gerar visualização" Command="{Binding BuildCommand}"/><Button Text="Salvar PDF" Command="{Binding PdfCommand}"/>
            </VerticalStackLayout>
            <VerticalStackLayout FlexLayout.Basis="400" FlexLayout.Grow="2" Spacing="8"><Label Text="Prévia" Style="{StaticResource SectionTitle}"/><Border Style="{StaticResource AppCard}"><Label Text="{Binding Preview}" LineBreakMode="WordWrap"/></Border></VerticalStackLayout>
        </FlexLayout>
        <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}"/><Label Text="{Binding Status}" Style="{StaticResource BodySecondary}"/>
    </VerticalStackLayout></ScrollView>
</ContentPage>
