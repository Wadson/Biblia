<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:components="clr-namespace:Biblia.Presentation.Components" x:Class="Biblia.Presentation.Views.MessageReferencesPage" Title="Referências da mensagem" BackgroundColor="{StaticResource BtAppBackground}" Shell.BackgroundColor="{StaticResource BtHeader}" Shell.TitleColor="White">
 <Shell.BackButtonBehavior><BackButtonBehavior IsVisible="False" IsEnabled="True"/></Shell.BackButtonBehavior>
 <Shell.TitleView><components:PageHeaderView Title="Referências da mensagem"/></Shell.TitleView>
 <ScrollView><VerticalStackLayout Padding="16" Spacing="10" MaximumWidthRequest="820" HorizontalOptions="Center"><Label Text="Referências da mensagem" Style="{StaticResource BtPageTitleStyle}"/><CollectionView HeightRequest="52" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}" SelectionMode="Single"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="6"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource BtMenuItemStyle}" Padding="10,5"><Label Text="{Binding Title}"/></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView><CollectionView HeightRequest="48" ItemsSource="{Binding Topics}" SelectedItem="{Binding SelectedTopic}" SelectionMode="Single"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="6"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource BtMenuItemStyle}" Padding="10,5"><Label Text="{Binding Title}"/></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView><Border Style="{StaticResource BtEditorContainerStyle}"><Editor Placeholder="Observação contextual para esta mensagem" Text="{Binding Observation}" MinimumHeightRequest="110"/></Border><CollectionView HeightRequest="300" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" SelectionMode="Single"><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource BtCardStyle}" Margin="0,4"><VerticalStackLayout><Label Text="{Binding DisplayReference}" FontAttributes="Bold" TextColor="{StaticResource BtPrimary}"/><Label Text="{Binding Observation}" MaxLines="2" Style="{StaticResource BtSubtitleStyle}"/></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate><CollectionView.EmptyView><Label Text="Nenhuma referência vinculada." Style="{StaticResource BtSubtitleStyle}"/></CollectionView.EmptyView></CollectionView><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="Salvar observação" Style="{StaticResource BtPrimaryButtonStyle}" Command="{Binding SaveCommand}"/><Button Grid.Column="1" Text="Remover vínculo" Style="{StaticResource BtDangerButtonStyle}" Command="{Binding DeleteCommand}"/></Grid><Border Style="{StaticResource BtStatusInfoStyle}"><Label Text="{Binding Status}" Style="{StaticResource BtSubtitleStyle}"/></Border></VerticalStackLayout></ScrollView>
</ContentPage>
