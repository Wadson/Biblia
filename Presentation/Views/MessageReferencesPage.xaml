<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Biblia.Presentation.Views.MessageReferencesPage" Title="Referências da mensagem"><ScrollView><VerticalStackLayout Padding="16" Spacing="10"><Label Text="Referências da mensagem" Style="{StaticResource PageTitle}"/><CollectionView HeightRequest="48" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="6"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource AppCard}" Padding="10,4"><Label Text="{Binding Title}"/></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView><CollectionView HeightRequest="44" ItemsSource="{Binding Topics}" SelectedItem="{Binding SelectedTopic}"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" ItemSpacing="6"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource AppCard}" Padding="10,4"><Label Text="{Binding Title}"/></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView><Editor Placeholder="Observação contextual para esta mensagem" Text="{Binding Observation}" MinimumHeightRequest="110"/><CollectionView HeightRequest="260" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" SelectionMode="Single"><CollectionView.ItemTemplate><DataTemplate><Border Style="{StaticResource AppCard}" Margin="0,4"><VerticalStackLayout><Label Text="{Binding DisplayReference}" FontAttributes="Bold"/><Label Text="{Binding Observation}" MaxLines="2"/></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate><CollectionView.EmptyView><Label Text="Nenhuma referência vinculada."/></CollectionView.EmptyView></CollectionView><FlexLayout Direction="Row" Wrap="Wrap"><Button FlexLayout.Basis="48%" Text="Salvar observação" Command="{Binding SaveCommand}"/><Button FlexLayout.Basis="48%" Text="Remover vínculo" Command="{Binding DeleteCommand}"/></FlexLayout><Label Text="{Binding Status}"/></VerticalStackLayout></ScrollView></ContentPage>
