<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:components="clr-namespace:Biblia.Presentation.Components" x:Class="Biblia.Presentation.Views.VerseCardStudioPage" Title="Criar card" BackgroundColor="{StaticResource BtAppBackground}" Shell.BackgroundColor="{StaticResource BtHeader}" Shell.TitleColor="White">
 <Shell.BackButtonBehavior><BackButtonBehavior IsVisible="False" IsEnabled="True"/></Shell.BackButtonBehavior>
 <Shell.TitleView><components:PageHeaderView Title="Criar card"/></Shell.TitleView>
 <Grid><ScrollView><VerticalStackLayout Padding="16" Spacing="14" MaximumWidthRequest="1180" HorizontalOptions="Center">
  <Label Text="Compartilhar uma Palavra" Style="{StaticResource PageTitle}"/><Label Text="Crie um card com um versículo e compartilhe com alguém." Style="{StaticResource BodySecondary}"/>
  <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Start">
   <VerticalStackLayout FlexLayout.Basis="360" FlexLayout.Grow="1" Spacing="12" Margin="0,0,12,12">
    <Border Style="{StaticResource BtCardStyle}" Padding="14"><VerticalStackLayout Spacing="9"><Label Text="Versículo" Style="{StaticResource SectionTitle}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="Versículo do Dia" Command="{Binding UseDailyCommand}" Style="{StaticResource BtSecondaryButtonStyle}"/><Button Grid.Column="1" Text="Escolher outro" Command="{Binding ChooseOtherCommand}" Style="{StaticResource BtSecondaryButtonStyle}"/></Grid><Border BackgroundColor="{StaticResource BtSelectedBackground}" Stroke="{StaticResource BtSelectedBorder}" Padding="10"><VerticalStackLayout><Label Text="{Binding Reference}" TextColor="{StaticResource BtPrimary}" FontAttributes="Bold"/><Label Text="{Binding VerseText}" MaxLines="4" LineBreakMode="TailTruncation"/><Label Text="{Binding VersionCode,StringFormat='Versão: {0}'}" Style="{StaticResource Caption}"/></VerticalStackLayout></Border>
     <VerticalStackLayout IsVisible="{Binding ChooseOther}" Spacing="6"><Button Text="{Binding VersionDisplay}" Clicked="OnSelectVersion" Style="{StaticResource BtSecondaryButtonStyle}"/><Button Text="{Binding BookDisplay}" Clicked="OnSelectBook" Style="{StaticResource BtSecondaryButtonStyle}"/><Grid ColumnDefinitions="*,*,*" ColumnSpacing="6"><Button Text="{Binding ChapterDisplay}" Clicked="OnSelectChapter" Style="{StaticResource BtSecondaryButtonStyle}" FontSize="12"/><Button Grid.Column="1" Text="{Binding VerseStartDisplay}" Clicked="OnSelectVerseStart" Style="{StaticResource BtSecondaryButtonStyle}" FontSize="12"/><Button Grid.Column="2" Text="{Binding VerseEndDisplay}" Clicked="OnSelectVerseEnd" Style="{StaticResource BtSecondaryButtonStyle}" FontSize="12"/></Grid></VerticalStackLayout>
    </VerticalStackLayout></Border>
    <Border Style="{StaticResource BtCardStyle}" Padding="14"><VerticalStackLayout Spacing="8"><Label Text="Mensagem" Style="{StaticResource SectionTitle}"/><Label Text="Tema" Style="{StaticResource FieldLabel}"/><Button Text="{Binding ThemeDisplay}" Clicked="OnSelectTheme" Style="{StaticResource BtSecondaryButtonStyle}"/><Label Text="Saudação" Style="{StaticResource FieldLabel}"/><Button Text="{Binding Greeting}" Clicked="OnSelectGreeting" Style="{StaticResource BtSecondaryButtonStyle}"/><Entry Placeholder="Digite a saudação" Text="{Binding CustomGreeting}" IsVisible="{Binding IsCustomGreeting}"/><Label Text="Formato" Style="{StaticResource FieldLabel}"/><Button Text="{Binding Format}" Clicked="OnSelectFormat" Style="{StaticResource BtSecondaryButtonStyle}"/><Label Text="Template" Style="{StaticResource FieldLabel}"/><Button Text="{Binding Template}" Clicked="OnSelectTemplate" Style="{StaticResource BtSecondaryButtonStyle}"/><Label Text="{Binding OverlayDisplay}" Style="{StaticResource FieldLabel}"/><Slider Minimum="0.3" Maximum="0.6" Value="{Binding OverlayOpacity}" MinimumTrackColor="{StaticResource BtPrimary}" MaximumTrackColor="{StaticResource BtBorder}"/></VerticalStackLayout></Border>
    <Border Style="{StaticResource BtCardStyle}" Padding="14"><VerticalStackLayout Spacing="8"><Label Text="Fundo" Style="{StaticResource SectionTitle}"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Button Text="{Binding Category}" Clicked="OnSelectCategory" Style="{StaticResource BtSecondaryButtonStyle}"/><Button Grid.Column="1" Text="Buscar fotos" Command="{Binding SearchPhotosCommand}" Style="{StaticResource BtPrimaryButtonStyle}"/></Grid><Border IsVisible="{Binding HasMediaStatus}" BackgroundColor="{StaticResource BtSelectedBackground}" Stroke="{StaticResource BtSelectedBorder}" Padding="10"><Label Text="{Binding MediaStatus}" TextColor="{StaticResource BtPrimary}" FontSize="13"/></Border><Label Text="Fotos fornecidas por Pexels" Style="{StaticResource Caption}"/><WebView x:Name="PhotoGallery" Source="{Binding GallerySource}" Navigating="OnGalleryNavigating" HeightRequest="300"/><Button Text="Carregar mais fotos" Command="{Binding LoadMorePhotosCommand}" IsVisible="{Binding HasMorePhotos}" Style="{StaticResource BtSecondaryButtonStyle}"/></VerticalStackLayout></Border>
   </VerticalStackLayout>
   <VerticalStackLayout FlexLayout.Basis="430" FlexLayout.Grow="2" Spacing="10"><Label Text="Prévia" Style="{StaticResource SectionTitle}"/><Border Stroke="{StaticResource BtBorder}" BackgroundColor="{Binding PreviewBackgroundColor}" StrokeShape="RoundRectangle 18" MaximumWidthRequest="430" HeightRequest="{Binding PreviewHeight}" HorizontalOptions="Center"><Grid><BoxView Color="Black"/><components:CachedPhotoImage SourcePath="{Binding SelectedPhoto.PreviewPath}" Aspect="AspectFill" InputTransparent="True" Opacity="{Binding PreviewImageOpacity}"/><Grid Padding="32,48,32,24" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" RowSpacing="18"><Label Text="{Binding GreetingText}" TextColor="{StaticResource BtGoldSoft}" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" TextTransform="Uppercase"/><Label Grid.Row="1" Text="{Binding ThemeText}" TextColor="{StaticResource BtGold}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" TextTransform="Uppercase"/><Label Grid.Row="2" Text="{Binding VerseText}" TextColor="White" FontSize="{Binding PreviewVerseSize}" LineHeight="1.25" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" LineBreakMode="WordWrap"/><Label Grid.Row="3" Text="{Binding Reference}" TextColor="{StaticResource BtGoldSoft}" FontSize="17" FontAttributes="Bold" HorizontalTextAlignment="Center"/><Label Grid.Row="4" Text="{Binding VersionCode}" TextColor="White" Opacity="0.85" HorizontalTextAlignment="Center"/><Label Grid.Row="5" Text="BíbliaTema" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="Center"/><Label Grid.Row="6" Text="{Binding PhotoAttribution}" TextColor="White" Opacity="0.75" FontSize="10" HorizontalTextAlignment="Center"/></Grid></Grid></Border><Button Text="Gerar card em PNG" Command="{Binding RenderCommand}" Style="{StaticResource BtPrimaryButtonStyle}" MaximumWidthRequest="430" HorizontalOptions="Center"/></VerticalStackLayout>
  </FlexLayout><ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}"/><Label Text="{Binding Status}" Style="{StaticResource BodySecondary}"/>
 </VerticalStackLayout></ScrollView>
 <Grid IsVisible="{Binding ResultVisible}" BackgroundColor="{StaticResource BtOverlay}" ZIndex="100"><Border Style="{StaticResource BtCardStyle}" Padding="20" Margin="22" MaximumWidthRequest="460" VerticalOptions="Center"><VerticalStackLayout Spacing="12"><Label Text="Card pronto" Style="{StaticResource PageTitle}"/><Label Text="A imagem PNG foi gerada. O que deseja fazer?" Style="{StaticResource BodySecondary}"/><Button Text="Salvar imagem" Command="{Binding SaveCommand}" Style="{StaticResource BtPrimaryButtonStyle}"/><Button Text="Compartilhar" Command="{Binding ShareCommand}" Style="{StaticResource BtSecondaryButtonStyle}"/><Button Text="Cancelar" Clicked="OnCancelResult" Style="{StaticResource BtSecondaryButtonStyle}"/></VerticalStackLayout></Border></Grid>
 <Grid x:Name="SelectorOverlay" IsVisible="False" BackgroundColor="{StaticResource BtOverlay}" ZIndex="200" Padding="18"><Border Style="{StaticResource BtCardStyle}" Padding="16" VerticalOptions="Center" MaximumWidthRequest="560" MaximumHeightRequest="650"><Grid RowDefinitions="Auto,*" RowSpacing="12"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout Spacing="2"><Label x:Name="SelectorTitle" Style="{StaticResource BtSectionTitleStyle}"/><Label Text="Toque em uma opção para selecionar" Style="{StaticResource BtSubtitleStyle}"/></VerticalStackLayout><Button Grid.Column="1" Text="✕" Style="{StaticResource BtIconButtonStyle}" Clicked="OnCloseSelector"/></Grid><CollectionView x:Name="SelectorList" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnSelectorChanged"><CollectionView.ItemTemplate><DataTemplate><Grid Margin="0,2"><VisualStateManager.VisualStateGroups><VisualStateGroup Name="SelectionStates"><VisualState Name="Normal"><VisualState.Setters><Setter TargetName="OptionCard" Property="Border.BackgroundColor" Value="{StaticResource BtSurface}"/><Setter TargetName="OptionCard" Property="Border.Stroke" Value="{StaticResource BtBorder}"/><Setter TargetName="OptionText" Property="Label.TextColor" Value="{StaticResource BtTextPrimary}"/></VisualState.Setters></VisualState><VisualState Name="Selected"><VisualState.Setters><Setter TargetName="OptionCard" Property="Border.BackgroundColor" Value="{StaticResource BtSelectedBackground}"/><Setter TargetName="OptionCard" Property="Border.Stroke" Value="{StaticResource BtSelectedBorder}"/><Setter TargetName="OptionText" Property="Label.TextColor" Value="{StaticResource BtPrimary}"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups><Border x:Name="OptionCard" Padding="14,11" StrokeShape="RoundRectangle 12"><Grid ColumnDefinitions="24,*"><Label Text="●" TextColor="{StaticResource BtPrimary}" VerticalTextAlignment="Center"/><Label x:Name="OptionText" Grid.Column="1" Text="{Binding Text}" FontSize="16" FontAttributes="Bold"/></Grid></Border></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView></Grid></Border></Grid>
 </Grid>
</ContentPage>





