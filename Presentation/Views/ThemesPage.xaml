<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:components="clr-namespace:Biblia.Presentation.Components" x:Class="Biblia.Presentation.Views.ThemesPage" Title="Temas" BackgroundColor="{StaticResource BtAppBackground}">
 <Shell.TitleView><components:PageHeaderView Title="Temas" FallbackRoute="//Home"/></Shell.TitleView>
 <Grid><ScrollView><VerticalStackLayout Padding="16" Spacing="14" MaximumWidthRequest="1100" HorizontalOptions="Center">
  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10"><VerticalStackLayout><Label Text="Temas" Style="{StaticResource BtPageTitleStyle}" FontAutoScalingEnabled="False"/><Label Text="Organize suas referências por assunto e cor." Style="{StaticResource BtSubtitleStyle}"/></VerticalStackLayout><Button Grid.Column="1" Text="Editar selecionado" Style="{StaticResource BtSecondaryButtonStyle}" Command="{Binding EditCommand}" FontSize="13" FontAutoScalingEnabled="False" VerticalOptions="Center"/><Button Grid.Column="2" Text="＋ Novo tema" Style="{StaticResource BtPrimaryButtonStyle}" Command="{Binding NewCommand}" FontSize="14" FontAutoScalingEnabled="False" VerticalOptions="Center"/></Grid>
  <Border Style="{StaticResource BtCardStyle}" Padding="12"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Border Style="{StaticResource BtSearchContainerStyle}"><Entry Placeholder="Pesquisar tema" Text="{Binding SearchText}" ReturnType="Search" ReturnCommand="{Binding SearchCommand}"/></Border><Button Grid.Column="1" Text="Pesquisar" Style="{StaticResource BtPrimaryButtonStyle}" Command="{Binding SearchCommand}" FontSize="13" FontAutoScalingEnabled="False"/></Grid></Border>
  <Grid x:Name="ThemesGrid" RowDefinitions="Auto,Auto" ColumnDefinitions="*" RowSpacing="14"><VisualStateManager.VisualStateGroups><VisualStateGroup><VisualState x:Name="Narrow"/><VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="820"/></VisualState.StateTriggers><VisualState.Setters><Setter TargetName="ThemesGrid" Property="Grid.ColumnDefinitions" Value="0.8*,1.2*"/><Setter TargetName="ThemeEditor" Property="Grid.Row" Value="0"/><Setter TargetName="ThemeEditor" Property="Grid.Column" Value="1"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
   <VerticalStackLayout Grid.Row="0" Spacing="6"><Label Text="Temas cadastrados" Style="{StaticResource BtSectionTitleStyle}"/><CollectionView HeightRequest="280" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedTheme}" SelectionMode="Single"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="4"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate><Grid><VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="SelectionStates"><VisualState x:Name="Normal"><VisualState.Setters><Setter TargetName="ThemeCard" Property="Border.BackgroundColor" Value="#FFFFFF"/><Setter TargetName="ThemeCard" Property="Border.Stroke" Value="#E0E0E0"/><Setter TargetName="ThemeName" Property="Label.TextColor" Value="#0A0A0A"/></VisualState.Setters></VisualState><VisualState x:Name="Selected"><VisualState.Setters><Setter TargetName="ThemeCard" Property="Border.BackgroundColor" Value="#E4EDF7"/><Setter TargetName="ThemeCard" Property="Border.Stroke" Value="#B8D4F0"/><Setter TargetName="ThemeName" Property="Label.TextColor" Value="#0066CC"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups><Border x:Name="ThemeCard" Style="{StaticResource BtCardStyle}" Padding="10,8"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="9"><Border WidthRequest="20" HeightRequest="20" Padding="0" BackgroundColor="{Binding ColorHex}" Stroke="{StaticResource BtBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 10" VerticalOptions="Center"/><VerticalStackLayout Grid.Column="1" Spacing="1"><Label x:Name="ThemeName" Text="{Binding Name}" FontAttributes="Bold" FontSize="16"/><Label Text="{Binding Description}" MaxLines="1" FontSize="12" TextColor="{StaticResource BtTextSecondary}"/></VerticalStackLayout></Grid></Border></Grid></DataTemplate></CollectionView.ItemTemplate><CollectionView.EmptyView><Border Style="{StaticResource BtCardStyle}" Margin="0,4" Padding="12"><VerticalStackLayout><Label Text="Nenhum tema cadastrado." FontAttributes="Bold"/><Label Text="Crie o primeiro tema no formulário abaixo." Style="{StaticResource BtSubtitleStyle}"/></VerticalStackLayout></Border></CollectionView.EmptyView></CollectionView></VerticalStackLayout>
   <VerticalStackLayout x:Name="ThemeEditor" Grid.Row="1" Spacing="10"><Border Style="{StaticResource BtCardStyle}"><VerticalStackLayout Spacing="10"><Label Text="{Binding EditorTitle}" Style="{StaticResource BtSectionTitleStyle}"/><Label Text="Nome do tema *" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource BtEntryContainerStyle}"><Entry Text="{Binding Name}" Placeholder="Ex.: Salvação"/></Border><Label Text="{Binding ValidationError}" TextColor="{StaticResource BtDanger}"/>
    <Label Text="Cor do tema" Style="{StaticResource FieldLabel}"/><Label Text="Escolha uma cor para identificar o tema nas referências." Style="{StaticResource BtSubtitleStyle}"/><components:ThemeColorPickerView ColorOptions="{Binding ColorOptions}" SelectedColor="{Binding SelectedColor}"/>
    <Border Style="{StaticResource BtSelectedCardStyle}" Padding="12"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><Border WidthRequest="34" HeightRequest="34" Padding="0" BackgroundColor="{Binding ColorHex}" Stroke="{StaticResource BtSelectedBorder}" StrokeThickness="2" StrokeShape="RoundRectangle 17"/><VerticalStackLayout Grid.Column="1"><Label Text="Cor selecionada" Style="{StaticResource FieldLabel}"/><Label Text="{Binding SelectedColorName}" TextColor="{StaticResource BtPrimary}" FontAttributes="Bold"/></VerticalStackLayout></Grid></Border>
    <Border Style="{StaticResource BtCardStyle}" Padding="12,10" Shadow="{x:Null}"><VerticalStackLayout Spacing="6"><Label Text="Prévia do tema" Style="{StaticResource Caption}" HorizontalTextAlignment="Center"/><HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="9"><Border WidthRequest="20" HeightRequest="20" Padding="0" BackgroundColor="{Binding ColorHex}" Stroke="{StaticResource BtBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 10" VerticalOptions="Center"/><Label Text="{Binding Name, TargetNullValue='Nome do tema'}" TextColor="{StaticResource BtTextPrimary}" FontAttributes="Bold" FontSize="17" VerticalTextAlignment="Center"/></HorizontalStackLayout></VerticalStackLayout></Border>
    <Label Text="Descrição" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource BtEditorContainerStyle}"><Editor Text="{Binding Description}" Placeholder="Descreva este tema..." MinimumHeightRequest="110" AutoSize="TextChanges"/></Border>
    <Border IsVisible="{Binding DeleteConfirmationVisible}" Style="{StaticResource BtStatusErrorStyle}" Padding="12"><VerticalStackLayout Spacing="8"><Label Text="Excluir tema?" FontAttributes="Bold" TextColor="{StaticResource BtDanger}"/><Label Text="O tema será removido, mas as referências bíblicas serão preservadas."/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="Voltar" Style="{StaticResource BtSecondaryButtonStyle}" Command="{Binding CancelDeleteCommand}" FontSize="13" FontAutoScalingEnabled="False"/><Button Grid.Column="1" Text="Confirmar exclusão" Style="{StaticResource BtDangerButtonStyle}" Command="{Binding ConfirmDeleteCommand}" FontSize="12" FontAutoScalingEnabled="False"/></Grid></VerticalStackLayout></Border>
    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="8" ColumnSpacing="8"><Button Text="Cancelar" Style="{StaticResource BtSecondaryButtonStyle}" Command="{Binding CancelCommand}" FontSize="13" FontAutoScalingEnabled="False"/><Button Grid.Column="1" Text="Salvar tema" Style="{StaticResource BtPrimaryButtonStyle}" Command="{Binding SaveCommand}" FontSize="13" FontAutoScalingEnabled="False"/><Button Grid.Row="1" Grid.ColumnSpan="2" Text="Excluir tema" Style="{StaticResource BtDangerButtonStyle}" Command="{Binding DeleteCommand}" IsVisible="{Binding IsEditMode}" FontSize="13" FontAutoScalingEnabled="False"/></Grid>
   </VerticalStackLayout></Border><Border Style="{StaticResource BtStatusInfoStyle}"><Label Text="{Binding Status}" Style="{StaticResource BtSubtitleStyle}"/></Border></VerticalStackLayout>
  </Grid>
 </VerticalStackLayout></ScrollView><Grid BackgroundColor="{StaticResource BtOverlaySoft}" IsVisible="{Binding IsBusy}" ZIndex="100"><Border Style="{StaticResource BtCardStyle}" HorizontalOptions="Center" VerticalOptions="Center"><HorizontalStackLayout Spacing="10"><ActivityIndicator IsRunning="True"/><Label Text="Salvando tema..." VerticalOptions="Center"/></HorizontalStackLayout></Border></Grid></Grid>
</ContentPage>
