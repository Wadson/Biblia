<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Biblia.AppShell" FlyoutBackgroundColor="#F4F6F9" FlyoutWidth="324" FlyoutBehavior="Flyout" FlyoutHeaderBehavior="Fixed">
 <Shell.Resources>
  <!-- Recursos locais evitam falha de resolução precoce no Android. -->
  <Color x:Key="SelectedBackground">#E4EDF7</Color><Color x:Key="SelectedBorder">#B8D4F0</Color><Color x:Key="MenuSurface">#FFFFFF</Color><Color x:Key="MenuBorder">#E0E0E0</Color><Color x:Key="MenuPrimary">#0066CC</Color><Color x:Key="MenuText">#0A0A0A</Color><Color x:Key="MenuDisabled">#A3AAB2</Color>
  <DataTemplate x:Key="ModernFlyoutItemTemplate">
   <Border x:Name="ItemBorder" WidthRequest="296" HorizontalOptions="Center" BackgroundColor="Transparent" Stroke="Transparent" StrokeThickness="1" StrokeShape="RoundRectangle 14" Margin="0,2" Padding="8,6">
    <Border.Triggers><DataTrigger TargetType="Border" Binding="{Binding IsEnabled}" Value="False"><Setter Property="BackgroundColor" Value="Transparent"/><Setter Property="Stroke" Value="Transparent"/><Setter Property="StrokeThickness" Value="0"/><Setter Property="Padding" Value="8,3"/><Setter Property="Margin" Value="0,10,0,2"/></DataTrigger></Border.Triggers>
    <Grid x:Name="ItemGrid" ColumnDefinitions="4,42,*" HeightRequest="42" ColumnSpacing="6">
     <BoxView x:Name="SelectionBar" Color="Transparent" WidthRequest="4" CornerRadius="2" VerticalOptions="Fill"/>
     <Border x:Name="IconContainer" Grid.Column="1" WidthRequest="38" HeightRequest="38" Padding="9" BackgroundColor="{StaticResource MenuSurface}" Stroke="{StaticResource MenuBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 11" HorizontalOptions="Center" VerticalOptions="Center"><Image x:Name="ItemIcon" Source="{Binding FlyoutIcon}" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/></Border>
     <Label x:Name="ItemTitle" Grid.Column="2" Text="{Binding Title}" TextColor="{StaticResource MenuText}" FontSize="14" VerticalTextAlignment="Center" Margin="5,0,0,0"><Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding IsEnabled}" Value="False"><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="3"/><Setter Property="Margin" Value="4,0"/><Setter Property="FontSize" Value="11"/><Setter Property="FontAttributes" Value="Bold"/><Setter Property="TextColor" Value="{StaticResource MenuPrimary}"/><Setter Property="CharacterSpacing" Value="1.1"/></DataTrigger></Label.Triggers></Label>
     <Grid.Triggers><DataTrigger TargetType="Grid" Binding="{Binding IsEnabled}" Value="False"><Setter Property="ColumnDefinitions" Value="*"/><Setter Property="HeightRequest" Value="28"/></DataTrigger></Grid.Triggers>
    </Grid>
    <VisualStateManager.VisualStateGroups><VisualStateGroupList><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"><VisualState.Setters><Setter TargetName="ItemBorder" Property="BackgroundColor" Value="Transparent"/><Setter TargetName="ItemBorder" Property="Stroke" Value="Transparent"/><Setter TargetName="ItemTitle" Property="Label.TextColor" Value="{StaticResource MenuText}"/><Setter TargetName="ItemTitle" Property="Label.FontAttributes" Value="None"/><Setter TargetName="SelectionBar" Property="BoxView.Color" Value="Transparent"/></VisualState.Setters></VisualState><VisualState x:Name="Selected"><VisualState.Setters><Setter TargetName="ItemBorder" Property="BackgroundColor" Value="{StaticResource SelectedBackground}"/><Setter TargetName="ItemBorder" Property="Stroke" Value="{StaticResource SelectedBorder}"/><Setter TargetName="IconContainer" Property="Border.BackgroundColor" Value="{StaticResource MenuSurface}"/><Setter TargetName="IconContainer" Property="Border.Stroke" Value="{StaticResource SelectedBorder}"/><Setter TargetName="SelectionBar" Property="BoxView.Color" Value="{StaticResource MenuPrimary}"/><Setter TargetName="ItemTitle" Property="Label.TextColor" Value="{StaticResource MenuPrimary}"/><Setter TargetName="ItemTitle" Property="Label.FontAttributes" Value="Bold"/></VisualState.Setters></VisualState><VisualState x:Name="Pressed"><VisualState.Setters><Setter TargetName="ItemBorder" Property="BackgroundColor" Value="{StaticResource SelectedBackground}"/><Setter TargetName="ItemBorder" Property="Stroke" Value="{StaticResource SelectedBorder}"/></VisualState.Setters></VisualState><VisualState x:Name="Disabled"><VisualState.Setters><Setter TargetName="ItemBorder" Property="Opacity" Value="1"/><Setter TargetName="ItemTitle" Property="Label.TextColor" Value="{StaticResource MenuPrimary}"/><Setter TargetName="ItemTitle" Property="Label.FontAttributes" Value="Bold"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateGroupList></VisualStateManager.VisualStateGroups>
   </Border>
  </DataTemplate>
 </Shell.Resources>
 <Shell.ItemTemplate><StaticResourceExtension Key="ModernFlyoutItemTemplate"/></Shell.ItemTemplate>
 <Shell.FlyoutHeader>
  <Grid HeightRequest="166" Padding="18,20,18,16" BackgroundColor="#0D1E30">
   <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="72,*" ColumnSpacing="14" RowSpacing="10" VerticalOptions="Center">
    <Border WidthRequest="68" HeightRequest="68" Padding="8" BackgroundColor="#17334F" Stroke="#D4AF37" StrokeThickness="1.5" StrokeShape="RoundRectangle 20" HorizontalOptions="Start" VerticalOptions="Center" SemanticProperties.Description="Ícone da Bíblia">
     <Image Source="bt_logo.svg" WidthRequest="52" HeightRequest="52" Aspect="AspectFit"/>
    </Border>
    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
     <HorizontalStackLayout Spacing="0"><Label Text="Bíblia" TextColor="White" FontSize="23" FontAttributes="Bold"/><Label Text="Tema" TextColor="#D4AF37" FontSize="23" FontAttributes="Bold"/></HorizontalStackLayout>
     <Label Text="PREMIUM EDITION" TextColor="#F3E5AB" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.7"/>
    </VerticalStackLayout>
    <Label Grid.Row="1" Grid.ColumnSpan="2" Text="Estudo bíblico, temas e inspiração." TextColor="#D7E2EC" FontSize="12" LineBreakMode="TailTruncation"/>
   </Grid>
  </Grid>
 </Shell.FlyoutHeader>
 <Shell.FlyoutFooter>
  <Border x:Name="ExitFlyoutButton" WidthRequest="296" HorizontalOptions="Center" BackgroundColor="{StaticResource MenuSurface}" Stroke="{StaticResource MenuBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Margin="0,4,0,12" Padding="12,7" HeightRequest="54" SemanticProperties.Description="Sair" SemanticProperties.Hint="Sair do aplicativo">
   <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnExitTapped"/></Border.GestureRecognizers>
   <Grid ColumnDefinitions="36,*"><Image Source="icon_exit.svg" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/><Label Grid.Column="1" Text="Sair" TextColor="{StaticResource MenuText}" FontSize="14" VerticalTextAlignment="Center" Margin="8,0,0,0"/></Grid>
  </Border>
 </Shell.FlyoutFooter>
</Shell>
